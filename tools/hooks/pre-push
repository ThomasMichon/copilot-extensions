#!/bin/sh
# Re-exec under a real bash. Testing BASH_VERSION is not enough: on a BSD host
# /bin/sh IS bash in sh mode, which sets BASH_VERSION but disables the process
# substitution this hook uses. Gate on an explicit marker instead.
[ -n "${COPILOT_EXTENSIONS_HOOK_BASH:-}" ] ||
    COPILOT_EXTENSIONS_HOOK_BASH=1 exec bash "$0" "$@"
# pre-push is a short publication-safety boundary, not a repository CI run.
# Keep private identifier and pushed-blob checks here. Staged lint/structure
# checks run at pre-commit; all repository guards remain in required CI.
# Enable with:  git config core.hooksPath tools/hooks
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# Resolve a *working* python. Skip the Windows Store execution-alias stub under
# WindowsApps (it only prints an install message and exits non-zero), and fall
# back to the `py` launcher on Windows.
PY=()
for c in python3 python; do
    p="$(command -v "$c" 2>/dev/null || true)"
    case "$p" in *WindowsApps*) continue ;; esac
    if [[ -n "$p" ]]; then PY=("$p"); break; fi
done
if [[ ${#PY[@]} -eq 0 ]] && command -v py >/dev/null 2>&1; then
    PY=(py -3)
fi
if [[ ${#PY[@]} -eq 0 ]]; then
    echo "pre-push: python not found -- skipping pre-push checks" >&2
    exit 0
fi
# No-op unless a private denylist is configured (env / ~/.agent-codespaces).
# Scoped to origin/dev, not the script's own origin/main default: dev is this
# repo's real contribution trunk (CONTRIBUTING.md), and dev/main have
# diverged enough (dev-branch-release-pipeline effort) that diffing against
# origin/main would sweep in dev's entire independent history on every push,
# not just this push's own changes.
COPILOT_EXTENSIONS_GUARD_BASE=origin/dev "${PY[@]}" "$ROOT/tools/check-no-internal-identifiers.py"
# Block check-in of oversized files (a generous cap for images, a tight cap
# for everything else, and an outright ban on source maps/raw diffs) -- the
# guard the main-history-rewrite effort's ~300MB of accumulated
# coverage-baseline blobs never had. See tools/check-large-files.py.
#
# Reads the actual refs being pushed from stdin (the standard pre-push hook
# protocol: "<local ref> <local sha> <remote ref> <remote sha>" per line) and
# checks each non-deletion local sha explicitly as --head, rather than
# assuming the currently checked-out HEAD is what's being pushed -- pushing a
# non-checked-out branch, or several refs in one invocation, would otherwise
# send content this hook never actually inspected. (No other check in this
# file is ref-aware yet -- each still only ever looks at HEAD/the current
# checkout; broadening all of them is a separate, larger change.) Nothing
# else in this script reads stdin, so this is always safe to consume last.
# `[ -t 0 ]` falls back to plain HEAD when run manually from a terminal
# (no real push, nothing to read from stdin).
large_files_failed=0
if [ -t 0 ]; then
    "${PY[@]}" "$ROOT/tools/check-large-files.py" --base origin/dev || large_files_failed=1
else
    any_ref=0
    while read -r local_ref local_sha _remote_ref _remote_sha; do
        [[ -n "$local_ref" ]] || continue
        any_ref=1
        # All-zero local sha means this ref is being deleted -- nothing new
        # to check.
        [[ "$local_sha" =~ ^0+$ ]] && continue
        "${PY[@]}" "$ROOT/tools/check-large-files.py" --base origin/dev --head "$local_sha" || large_files_failed=1
    done
    if [[ "$any_ref" -eq 0 ]]; then
        # Stdin was empty/closed (e.g. a non-interactive test harness) --
        # fall back to plain HEAD so the guard still runs something.
        "${PY[@]}" "$ROOT/tools/check-large-files.py" --base origin/dev || large_files_failed=1
    fi
fi
exit "$large_files_failed"
