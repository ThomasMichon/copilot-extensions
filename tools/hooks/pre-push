#!/bin/sh
[ -n "${BASH_VERSION:-}" ] || exec bash "$0" "$@"
# pre-push hook: enforce the install contract and the internal-identifier guard
# before pushing.
# Enable with:  git config core.hooksPath tools/hooks
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# Resolve a *working* python. Skip the Windows Store execution-alias stub under
# WindowsApps (it only prints an install message and exits non-zero), and fall
# back to the `py` launcher on Windows.
PY=()
for c in python3 python; do
    p="$(command -v "$c" 2>/dev/null || true)"
    case "$p" in *WindowsApps*) continue ;; esac
    if [[ -n "$p" ]]; then PY=("$p"); break; fi
done
if [[ ${#PY[@]} -eq 0 ]] && command -v py >/dev/null 2>&1; then
    PY=(py -3)
fi
if [[ ${#PY[@]} -eq 0 ]]; then
    echo "pre-push: python not found -- skipping pre-push checks" >&2
    exit 0
fi
# No-op unless a private denylist is configured (env / ~/.agent-codespaces).
"${PY[@]}" "$ROOT/tools/check-no-internal-identifiers.py"
"${PY[@]}" "$ROOT/tools/check-install-contract.py"
# Shared production libraries are shipped from multiple plugin payloads; every
# copy must remain byte-identical before the launch guard scans each one.
"${PY[@]}" "$ROOT/tools/check-vendored-libs-sync.py"
# Every Windows process launch must be headless: an agent-procutil-adopting
# plugin must not hand-roll process-creation flags (windows-launch-hardening).
"${PY[@]}" "$ROOT/tools/check-headless-launch.py"
# Guard skill loadability: frontmatter validity + the 1024-char description limit
# the Copilot CLI enforces (over it, a skill is silently dropped at load time).
"${PY[@]}" "$ROOT/tools/check-skills.py"
# Keep the docs honest: plugin counts/lists and runbook skill/plugin references.
"${PY[@]}" "$ROOT/tools/check-docs-consistency.py"
"${PY[@]}" "$ROOT/tools/check-runbook-references.py"
# Keep each plugin's version identical across plugin.json / pyproject.toml /
# marketplace.json (a one-file bump wedges the Picker's update indicator).
"${PY[@]}" "$ROOT/tools/check-version-consistency.py"
# Freeze registered agent-bridge contracts and require a registry update when a
# contract-sensitive source changes.
"${PY[@]}" "$ROOT/tools/check-agent-bridge-contracts.py" --base origin/main
# Require a version bump whenever a plugin's content -- or a vendored lib it
# ships -- changes, so new code never serves under a stale version (the silent
# stale-deploy gap, dotfiles #1025). Diffs the push against origin/main.
exec "${PY[@]}" "$ROOT/tools/check-version-bump.py"
