#!/bin/sh
# Re-exec under a real bash. Testing BASH_VERSION is not enough: on a BSD host
# /bin/sh IS bash in sh mode, which sets BASH_VERSION but disables the process
# substitution this hook uses. Gate on an explicit marker instead.
[ -n "${COPILOT_EXTENSIONS_HOOK_BASH:-}" ] ||
    COPILOT_EXTENSIONS_HOOK_BASH=1 exec bash "$0" "$@"
# pre-push is a short publication-safety boundary, not a repository CI run.
# Keep private identifier and pushed-blob checks here. Staged lint/structure
# checks run at pre-commit; all repository guards remain in required CI.
# Enable with:  git config core.hooksPath tools/hooks
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# Resolve a *working* python. Skip the Windows Store execution-alias stub under
# WindowsApps (it only prints an install message and exits non-zero), and fall
# back to the `py` launcher on Windows.
PY=()
for c in python3 python; do
    p="$(command -v "$c" 2>/dev/null || true)"
    case "$p" in *WindowsApps*) continue ;; esac
    if [[ -n "$p" ]]; then PY=("$p"); break; fi
done
if [[ ${#PY[@]} -eq 0 ]] && command -v py >/dev/null 2>&1; then
    PY=(py -3)
fi
if [[ ${#PY[@]} -eq 0 ]]; then
    echo "pre-push: python not found -- skipping pre-push checks" >&2
    exit 0
fi
valid_oid() {
    [[ "$1" =~ ^([[:xdigit:]]{40}|[[:xdigit:]]{64})$ ]]
}

check_ref() {
    local head="$1" published="$2" base="" candidate resolved status
    if ! git -C "$ROOT" cat-file -e "$head^{commit}" 2>/dev/null; then
        echo "pre-push: pushed commit is unavailable; refusing unchecked publication" >&2
        return 1
    fi
    if [[ -n "$published" && ! "$published" =~ ^0+$ ]]; then
        if ! git -C "$ROOT" cat-file -e "$published^{commit}" 2>/dev/null; then
            echo "pre-push: published tip is unavailable; fetch it before publishing" >&2
            return 1
        fi
        if git -C "$ROOT" merge-base --is-ancestor "$published" "$head"; then
            base="$published"
        else
            status=$?
            if [[ "$status" -ne 1 ]]; then return "$status"; fi
        fi
    fi
    if [[ -z "$base" ]]; then
        for candidate in "${COPILOT_EXTENSIONS_GUARD_BASE:-origin/dev}" origin/main; do
            resolved="$(git -C "$ROOT" rev-parse --verify --quiet "$candidate^{commit}")" || continue
            if git -C "$ROOT" merge-base "$resolved" "$head" >/dev/null; then
                base="$resolved"
                break
            else
                status=$?
                if [[ "$status" -ne 1 ]]; then return "$status"; fi
            fi
        done
    fi
    if [[ -z "$base" ]]; then
        echo "pre-push: no related publication base; fetch the contribution/release branch" >&2
        return 1
    fi
    local failed=0
    "${PY[@]}" "$ROOT/tools/check-no-internal-identifiers.py" \
        --base "$base" --git-ref "$head" </dev/null || failed=1
    "${PY[@]}" "$ROOT/tools/check-large-files.py" \
        --base "$base" --head "$head" </dev/null || failed=1
    return "$failed"
}

# Git supplies both sides of every update. Do not let nested guards consume
# that protocol, or substitute the checked-out HEAD for an unselected ref.
guards_failed=0
if [ -t 0 ]; then
    check_ref "$(git -C "$ROOT" rev-parse HEAD)" "" || guards_failed=1
else
    any_ref=0
    while read -r local_ref local_sha remote_ref remote_sha extra || [[ -n "${local_ref:-}" ]]; do
        [[ -n "$local_ref" ]] || continue
        any_ref=1
        if [[ -n "$extra" ]] || ! valid_oid "$local_sha" || ! valid_oid "$remote_sha"; then
            echo "pre-push: malformed ref update; refusing unchecked publication" >&2
            exit 1
        fi
        [[ "$local_sha" =~ ^0+$ ]] && continue
        check_ref "$local_sha" "$remote_sha" || guards_failed=1
    done
    if [[ "$any_ref" -eq 0 ]]; then
        check_ref "$(git -C "$ROOT" rev-parse HEAD)" "" || guards_failed=1
    fi
fi
exit "$guards_failed"
