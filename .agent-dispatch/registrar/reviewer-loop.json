{
  "name": "copilot-extensions-review",
  "kind": "reviewer-loop",
  "repo": "github.com/ThomasMichon/copilot-extensions",
  "task_label": "self-hosted-review",
  "emitter": {
    "command": [
      "{python}",
      "plugins/copilot-extensions-harness/scripts/reviewer_source.py",
      "discover",
      "--policy",
      ".agent-dispatch/reviewer-loop.json"
    ],
    "interval_seconds": 900,
    "timeout_seconds": 120,
    "cwd": "../..",
    "task_output": "json",
    "side_load": {
      "command": [
        "{python}",
        "plugins/copilot-extensions-harness/scripts/reviewer_source.py",
        "side-load",
        "{change_ref}",
        "--policy",
        ".agent-dispatch/reviewer-loop.json"
      ]
    }
  },
  "evaluator": {
    "labels": [
      "internal:evaluator-only"
    ],
    "evaluator_spec": {
      "rules": []
    },
    "interval": 30
  },
  "pool": {
    "max_active_processes": 4,
    "interval": 30,
    "max_attempts": 3,
    "body": {
      "type": "headless",
      "agent": "cloud1"
    }
  },
  "description": "Self-hosted external pull-request reviewer loop"
}
