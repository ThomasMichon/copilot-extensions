__pycache__/
*.pyc


*.egg-info/

build/

# Local dev/test virtualenvs and caches (installers use ~/.agent-* venvs)
.venv/
.pytest_cache/
.ruff_cache/
# PowerShell writes this binary cache below the current HOME when tests
# sandbox profile state inside a plugin directory.
ModuleAnalysisCache
# pytest tmp_path artifacts (some suites symlink into a .pytmp working dir);
# never track these -- committed symlinks with absolute targets break plugin
# installs on Linux (dangling-symlink copy -> os error 2).
.pytmp/

# uv materializes a lockfile on `uv run`/`uv sync`. This repo does NOT pin uv
# lockfiles (they churn/reformat wholesale on `uv run` and block push-changes,
# #28), so ignore `uv.lock` repo-globally (unanchored -> every plugin, lib, and
# vendored copy). Each plugin ALSO ignores it in its own self-contained
# .gitignore. (Previously only a hand-maintained allow-list was ignored, and
# agent-bridge/dispatch/logger/machines/vault still tracked theirs.)
uv.lock
/libs/credential-relay/.testvenv/

# Cached per-plugin dev venvs built by tools/run-plugin-tests.py
/.test-venvs/

.venv-tools/
