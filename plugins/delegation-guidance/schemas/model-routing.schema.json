{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ThomasMichon/copilot-extensions/schemas/model-routing.schema.json",
  "title": "Delegated-work model routing",
  "description": "Evidence-backed model eligibility by delegated purpose and execution surface.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "purposes"
  ],
  "properties": {
    "schema": {
      "const": "copilot-extensions.model-routing"
    },
    "version": {
      "const": 1
    },
    "purposes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/entry"
        }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "state",
        "surfaces"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "demonstrated",
            "candidate",
            "held",
            "failed"
          ]
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "contextTiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "default",
              "long_context"
            ]
          }
        },
        "reasoningEfforts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          }
        },
        "costRank": {
          "type": "integer",
          "minimum": 0
        },
        "constraints": {
          "$ref": "#/$defs/stringList"
        },
        "fallbackOrder": {
          "$ref": "#/$defs/stringList"
        },
        "escalationConditions": {
          "$ref": "#/$defs/stringList"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "recheckAfter": {
          "type": "string",
          "format": "date"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "demonstrated"
              }
            }
          },
          "then": {
            "required": [
              "evidence"
            ],
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "observedAt",
        "sampleCount"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "observedAt": {
          "type": "string",
          "format": "date"
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
