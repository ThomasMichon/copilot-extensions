{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "powershell": "$r = if ($env:COPILOT_PLUGIN_ROOT) { $env:COPILOT_PLUGIN_ROOT } else { (Get-Location).Path }; $s = Join-Path (Join-Path $r 'scripts') 'emit-contribution-boundary.ps1'; if (Test-Path $s) { & $s } else { '{}' }",
        "bash": "r=\"${COPILOT_PLUGIN_ROOT:-$(pwd)}\"; s=\"$r/scripts/emit-contribution-boundary.sh\"; if [ -f \"$s\" ]; then bash \"$s\"; else printf '{}'; fi",
        "timeoutSec": 10
      }
    ]
  }
}
