#!/usr/bin/env sh
# Generated by libs/payload-invocation/generate.py. Do not edit.
set -eu

export PYTHONUTF8=1
_plugin="agent-logger"
_command="read-session-digest"
_self_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
_payload_root="$(CDPATH= cd -- "$_self_dir/.." && pwd -P)"

_boot_trace_ms() {
    _bt_raw=""
    if _bt_raw="$(date +%s%3N 2>/dev/null)"; then
        case "$_bt_raw" in
            [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9])
                printf '%s\n' "$_bt_raw"
                return 0
                ;;
        esac
    fi
    if _bt_raw="$(date +%s%N 2>/dev/null)"; then
        case "$_bt_raw" in
            [0-9]*)
                if [ "${#_bt_raw}" -eq 19 ]; then
                    printf '%s\n' "${_bt_raw%??????}"
                    return 0
                fi
                ;;
        esac
    fi
    if _bt_raw="$(date +%s 2>/dev/null)"; then
        case "$_bt_raw" in
            [0-9]*) printf '%s000\n' "$_bt_raw"; return 0 ;;
        esac
    fi
    printf '0000000000000\n'
}

_boot_trace() {
    _bt_phase="$1"
    _bt_dispatch_path="${2-}"
    _bt_now_ms="$(_boot_trace_ms)"
    [ -n "${COPILOT_EXTENSIONS_BOOT_TRACE:-}" ] || return 0
    if [ -n "$_bt_dispatch_path" ]; then
        printf '::boot-trace:: plugin=%s phase=%s t=%s path=%s\n' \
            "${COPILOT_EXTENSIONS_BOOT_TRACE_PLUGIN:-$_plugin}" \
            "$_bt_phase" "$_bt_now_ms" "$_bt_dispatch_path" >&2
    else
        printf '::boot-trace:: plugin=%s phase=%s t=%s\n' \
            "${COPILOT_EXTENSIONS_BOOT_TRACE_PLUGIN:-$_plugin}" \
            "$_bt_phase" "$_bt_now_ms" >&2
    fi
}

# This outer dispatcher template's own `$_runtime_root` is ALWAYS the
# LEGACY root (see generate.py's `runtimeRoot`/`legacyRuntimeRoot`
# resolution): installationContext=required plugins -- the only plugins
# that ever select this template -- may actually be running under a
# resolved, ACTIVE namespaced root that only the inner, installation-
# context-aware dispatcher knows how to determine. Writing shim-start/
# dispatch durably here, gated only on the legacy log directory already
# existing, would either lose those phases when the legacy dir happens
# not to exist yet, or silently misroute them into a stale legacy log
# that happens to still exist while a namespaced context is actually
# active (Copilot review, PR #3310). So this outer template never itself
# writes the durable record for these two early phases -- it forwards
# `shim-start`'s own timestamp via an env var so the inner dispatcher can
# log both phases once it has resolved whichever root is genuinely
# active. `COPILOT_EXTENSIONS_BOOT_TRACE` (opt-in stderr) still fires
# here immediately, unaffected by this deferral.
_boot_trace_shim_start_ms="$(_boot_trace_ms)"
_boot_trace shim-start

if [ ! -f "$_payload_root/plugin.json" ]; then
    printf '[%s] payload root is not a plugin: %s\n' "$_command" "$_payload_root" >&2
    exit 126
fi

case "$PWD/" in
    "$_payload_root/"*)
        _outside="${COPILOT_PROJECT_DIR:-$HOME}"
        [ -d "$_outside" ] || _outside="${TMPDIR:-/tmp}"
        cd "$_outside"
        ;;
esac

export COPILOT_EXTENSIONS_BOOT_TRACE_PLUGIN="$_plugin"
export COPILOT_EXTENSIONS_BOOT_TRACE_SHIM_START_MS="$_boot_trace_shim_start_ms"
_boot_trace dispatch
export AGENT_LOGGER_PAYLOAD_ROOT="$_payload_root"
export COPILOT_EXTENSIONS_PAYLOAD_COMMAND="$_command"
export COPILOT_EXTENSIONS_PAYLOAD_MODULE="agent_logger.segmenter.read_digest"
if ! command -v bash >/dev/null 2>&1; then
    printf '[read-session-digest] required payload dispatcher needs bash.\n' >&2
    exit 126
fi
exec bash "$_payload_root/scripts/runtime-gate.sh" "$@"
