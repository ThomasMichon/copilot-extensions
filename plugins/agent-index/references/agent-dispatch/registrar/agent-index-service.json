{
  "name": "agent-index-service",
  "kind": "plugin-companion",
  "transition_group": "agent-index-host-runtime",
  "spec": {
    "managed_runtime": {
      "schema_version": 1,
      "runtimes": [
        {
          "name": "service",
          "version": "0.1.0-dev138",
          "profile": "host",
          "python_env": "AGENT_INDEX_MANAGED_PYTHON",
          "projects": [
            {"path": "libs/zdd"},
            {"path": "libs/agent-procutil"},
            {"path": ".", "extras": ["store"]}
          ],
          "imports": [
            "agent_index.server",
            "lancedb",
            "pyarrow",
            "tree_sitter"
          ]
        }
      ]
    },
    "command": [
      "scripts/companion-service.py",
      "start"
    ],
    "stop_command": [
      "scripts/companion-service.py",
      "stop"
    ],
    "config_provider": [
      "scripts/companion-provider.py"
    ],
    "health_probe": [
      "scripts/companion-service.py",
      "health"
    ],
    "config_timeout_seconds": 45,
    "health_timeout_seconds": 10,
    "startup_timeout_seconds": 30,
    "stop_timeout_seconds": 15
  }
}
