{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "powershell": "$r = $env:COPILOT_PLUGIN_ROOT; if (-not $r) { $r = (Get-Location).Path }; $s = (Join-Path $r 'scripts\\bootstrap-check.ps1'); if (Test-Path $s) { & $s }",
        "bash": "r=\"${COPILOT_PLUGIN_ROOT:-$PWD}\"; s=\"$r/scripts/bootstrap-check.sh\"; [ -f \"$s\" ] && bash \"$s\"",
        "timeoutSec": 15
      },
      {
        "type": "command",
        "powershell": "$r = $env:COPILOT_PLUGIN_ROOT; if (-not $r) { $r = (Get-Location).Path }; $s = (Join-Path $r 'scripts\\ensure-service.ps1'); if (Test-Path $s) { & $s }",
        "bash": "r=\"${COPILOT_PLUGIN_ROOT:-$PWD}\"; s=\"$r/scripts/ensure-service.sh\"; [ -f \"$s\" ] && bash \"$s\"",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "powershell": "$r = $env:COPILOT_PLUGIN_ROOT; if (-not $r) { $r = (Get-Location).Path }; $s = (Join-Path $r 'scripts\\emit-command-catalog.ps1'); if (Test-Path $s) { & $s }",
        "bash": "r=\"${COPILOT_PLUGIN_ROOT:-$PWD}\"; s=\"$r/scripts/emit-command-catalog.sh\"; [ -f \"$s\" ] && bash \"$s\"",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "powershell": "$r = $env:COPILOT_PLUGIN_ROOT; if (-not $r) { $r = (Get-Location).Path }; $s = (Join-Path $r 'scripts\\emit-scope-binding.ps1'); if (Test-Path $s) { & $s }",
        "bash": "r=\"${COPILOT_PLUGIN_ROOT:-$PWD}\"; s=\"$r/scripts/emit-scope-binding.sh\"; [ -f \"$s\" ] && bash \"$s\"",
        "timeoutSec": 10
      }
    ]
  }
}
