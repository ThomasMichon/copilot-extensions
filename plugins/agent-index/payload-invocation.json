{
  "schema": "copilot-extensions.payload-invocation",
  "version": 2,
  "command": "agent-index",
  "module": "agent_index",
  "legacyRuntimeRoot": ".agent-index",
  "installationContext": "required",
  "noSelfProvisionEnv": "AGENT_INDEX_NO_SELFPROVISION",
  "purpose": "Search and operate the semantic index",
  "installer": "install",
  "sessionStartBootstrap": false,
  "payloadRootEnv": "AGENT_INDEX_PAYLOAD_ROOT",
  "catalogGate": "scripts/resolve_effective_config.py",
  "payloadDispatcher": {
    "posix": "scripts/runtime-gate.sh",
    "windows": "scripts/runtime-gate.ps1"
  },
  "installation": {
    "legacyFootprint": {
      "paths": [
        ".agent-index",
        ".local/bin/agent-index",
        ".local/bin/agent-index.cmd",
        ".local/bin/agent-index.ps1",
        ".config/systemd/user/agent-index.service",
        ".config/systemd/user/agent-index-engine.service"
      ],
      "services": [
        {
          "platform": "posix",
          "manager": "systemd-user",
          "name": "agent-index.service"
        },
        {
          "platform": "posix",
          "manager": "systemd-user",
          "name": "agent-index-engine.service"
        }
      ],
      "tasks": [
        {
          "platform": "windows",
          "manager": "windows-scheduled-task",
          "name": "agent-index"
        },
        {
          "platform": "windows",
          "manager": "windows-scheduled-task",
          "name": "agent-index-engine"
        }
      ]
    }
  }
}
