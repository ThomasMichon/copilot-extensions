{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "powershell": "$s = (Join-Path (Get-Location).Path 'scripts\\bootstrap-check.ps1'); if (Test-Path $s) { & $s }",
        "bash": "s=\"$PWD/scripts/bootstrap-check.sh\"; [ -f \"$s\" ] && bash \"$s\"",
        "timeoutSec": 15
      },
      {
        "type": "command",
        "powershell": "$s = (Join-Path (Get-Location).Path 'scripts\\focus-guidance.ps1'); if (Test-Path $s) { & $s } else { [Console]::Out.Write('{}') }",
        "bash": "s=\"$PWD/scripts/focus-guidance.sh\"; if [ -f \"$s\" ]; then bash \"$s\"; else printf '{}'; fi",
        "timeoutSec": 10
      }
    ]
  }
}
