{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "powershell": "$s = (Join-Path (Get-Location).Path 'scripts\\bootstrap-check.ps1'); if (Test-Path $s) { & $s }",
        "bash": "s=\"$PWD/scripts/bootstrap-check.sh\"; [ -f \"$s\" ] && bash \"$s\"",
        "timeoutSec": 15
      },
      {
        "type": "command",
        "powershell": "$s = (Join-Path (Get-Location).Path 'scripts\\register-bridge-provider.ps1'); if (Test-Path $s) { & $s }",
        "bash": "s=\"$PWD/scripts/register-bridge-provider.sh\"; [ -f \"$s\" ] && bash \"$s\"",
        "timeoutSec": 10
      }
    ]
  }
}
