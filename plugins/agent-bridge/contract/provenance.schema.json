{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable agent-bridge contract provenance prefix chunk",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "contract", "record_offset", "provenance"],
  "properties": {
    "schema": {"const": "agent-bridge.contract-provenance"},
    "schema_version": {"const": 1},
    "contract": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
    "record_offset": {"type": "integer", "minimum": 0},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "registry.schema.json#/$defs/runtimeProvenance"}
    }
  }
}
