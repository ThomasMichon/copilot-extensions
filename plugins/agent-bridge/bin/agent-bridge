#!/usr/bin/env sh
# Generated by libs/payload-invocation/generate.py. Do not edit.
set -eu

export PYTHONUTF8=1
_plugin="agent-bridge"
_command="agent-bridge"
_self_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
_payload_root="$(CDPATH= cd -- "$_self_dir/.." && pwd -P)"

_boot_trace_ms() {
    _bt_raw=""
    if _bt_raw="$(date +%s%3N 2>/dev/null)"; then
        case "$_bt_raw" in
            [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9])
                printf '%s\n' "$_bt_raw"
                return 0
                ;;
        esac
    fi
    if _bt_raw="$(date +%s%N 2>/dev/null)"; then
        case "$_bt_raw" in
            [0-9]*)
                if [ "${#_bt_raw}" -eq 19 ]; then
                    printf '%s\n' "${_bt_raw%??????}"
                    return 0
                fi
                ;;
        esac
    fi
    if _bt_raw="$(date +%s 2>/dev/null)"; then
        case "$_bt_raw" in
            [0-9]*) printf '%s000\n' "$_bt_raw"; return 0 ;;
        esac
    fi
    printf '0000000000000\n'
}

_boot_trace() {
    [ -n "${COPILOT_EXTENSIONS_BOOT_TRACE:-}" ] || return 0
    _bt_extra="${2-}"
    if [ -n "$_bt_extra" ]; then
        printf '::boot-trace:: plugin=%s phase=%s t=%s %s\n' \
            "${COPILOT_EXTENSIONS_BOOT_TRACE_PLUGIN:-$_plugin}" \
            "$1" "$(_boot_trace_ms)" "$_bt_extra" >&2
    else
        printf '::boot-trace:: plugin=%s phase=%s t=%s\n' \
            "${COPILOT_EXTENSIONS_BOOT_TRACE_PLUGIN:-$_plugin}" \
            "$1" "$(_boot_trace_ms)" >&2
    fi
}

_boot_trace shim-start

if [ ! -f "$_payload_root/plugin.json" ]; then
    printf '[%s] payload root is not a plugin: %s\n' "$_command" "$_payload_root" >&2
    exit 126
fi

case "$PWD/" in
    "$_payload_root/"*)
        _outside="${COPILOT_PROJECT_DIR:-$HOME}"
        [ -d "$_outside" ] || _outside="${TMPDIR:-/tmp}"
        cd "$_outside"
        ;;
esac

if [ -n "${COPILOT_EXTENSIONS_BOOT_TRACE:-}" ]; then
    export COPILOT_EXTENSIONS_BOOT_TRACE_PLUGIN="$_plugin"
fi
_boot_trace dispatch
export AGENT_BRIDGE_PAYLOAD_ROOT="$_payload_root"
if ! command -v bash >/dev/null 2>&1; then
    printf '[agent-bridge] required payload dispatcher needs bash.\n' >&2
    exit 126
fi
exec bash "$_payload_root/scripts/runtime-gate.sh" "$@"
