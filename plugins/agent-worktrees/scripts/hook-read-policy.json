  "nativeShellReadCommands": [
    "Get-Date",
    "Get-Item",
    "Get-ChildItem",
    "Get-Content",
    "Get-Location",
    "pwd",
    "ls",
    "cat"
  ],
  "nativeShellReadCommandKeys": [
    "command",
    "cmd",
    "script",
    "commandLine",
    "commandline",
    "input"
  ],
  "nativeShellReadArguments": {
    "version": 1,
    "read": "[ \\t]*(?:Get\\-Date|Get\\-Item|Get\\-ChildItem|Get\\-Content|Get\\-Location|pwd|ls|cat)(?:[ \\t]+[A-Za-z0-9_./:\\\\?*=-]+)*[ \\t]*",
    "reject": [
      "Set-Content|Add-Content|Out-File|New-Item|Remove-Item|Move-Item|Copy-Item|Clear-Content|Rename-Item|Tee-Object|>>?|\\btee\\b|\\bsed\\b\\s+-i|\\bcp\\b|\\bmv\\b|\\brm\\b|\\btouch\\b|\\bmkdir\\b|git\\s+(?:-C\\s+\\S+\\s+)?(?:add|commit|apply|mv|rm|checkout|restore)",
      "Set-Content|Add-Content|Out-File|New-Item|Remove-Item|Move-Item|Copy-Item|Clear-Content|Rename-Item|Set-ItemProperty|Tee-Object|>>?|\\btee\\b|\\bsed\\b\\s+-i|\\bcp\\b|\\bmv\\b|\\brm\\b|\\btouch\\b|\\bmkdir\\b|\\bdd\\b|\\btruncate\\b|\\bpatch\\b",
      "Set-Content|Add-Content|Out-File|New-Item|Remove-Item|Move-Item|Copy-Item|Clear-Content|Rename-Item|Set-ItemProperty|Tee-Object|>>?|\\btee\\b|\\bsed\\b\\s+-i|\\bcp\\b|\\bmv\\b|\\brm\\b|\\btouch\\b|\\bmkdir\\b|\\bdd\\b|\\btruncate\\b|\\bpatch\\b|\\bgit\\b",
      "\\bgh\\s+pr\\s+close\\s+(?:\\d+)\\b(?:[^;|&\\n\\r]*)",
      "\\bgh\\s+api\\s+(?:[\\w.-]+\\.com)?/?repos/(?:[\\w.-]+/[\\w.-]+)/pulls/(?:\\d+)\\b(?:[^;|&\\n\\r]*)"
    ]
  },
  "nativeShellReadDependencies": {
    "hook_pre_relevance.py": "5b6109ab45b8d81afe26b98bfd2bcfa1df45163724b93a8833c2d63b5ebebcae"
  }
}
