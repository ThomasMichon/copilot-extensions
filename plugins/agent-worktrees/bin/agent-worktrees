#!/bin/sh
# Cross-platform sh-runnable agent-worktrees shim. Lets any POSIX sh -- notably
# git's bundled sh on Windows, which runs hooks and cannot exec the .cmd/.ps1
# binstubs -- invoke the CLI. Resolves the runtime slot SOLELY via the
# junction-free `current-version` marker (the `.venv` link is retired; marker
# model, #581/#1085/#1106) -- prefers the slot's POSIX console script, then its
# Windows python via -m, then the newest installed slot; PATH python is the last
# resort (#234 defect 2).
export PYTHONUTF8=1
_awroot="$HOME/.agent-worktrees"
_awver=""
if [ -f "$_awroot/current-version" ]; then _awver=$(tr -d ' \t\r\n' < "$_awroot/current-version"); fi
_awslot="$_awroot/versions/$_awver"
if [ -n "$_awver" ] && [ -x "$_awslot/bin/agent-worktrees" ]; then
  exec "$_awslot/bin/agent-worktrees" "$@"
elif [ -n "$_awver" ] && [ -x "$_awslot/Scripts/python.exe" ]; then
  exec "$_awslot/Scripts/python.exe" -m agent_worktrees "$@"
fi
# Marker absent/stale: newest installed slot (POSIX then Windows layout).
_awcand=""
for _p in "$_awroot"/versions/*/bin/agent-worktrees; do [ -x "$_p" ] && _awcand="$_p"; done
if [ -n "$_awcand" ]; then exec "$_awcand" "$@"; fi
for _p in "$_awroot"/versions/*/Scripts/python.exe; do [ -x "$_p" ] && _awcand="$_p"; done
if [ -n "$_awcand" ]; then exec "$_awcand" -m agent_worktrees "$@"; fi

# No runtime slot exists -> self-provision on first use (runtime-self-provisioning
# pattern). This is the confined-host path: a Copilot app / cloud agent where the
# full launcher install never ran, so the agent-worktrees TOOLS (worktree/branch/
# change/session mgmt, esp. PR ops) still come up standalone. Provisioning is the
# LEAN `install.sh provision` (uv + venv + package + version marker), not the full
# launcher install. Announce (human line + machine-readable ::agent-provisioning::
# so a caller can extend its timeout), lock-serialize, fail-fast. Opt out with
# AGENT_WORKTREES_NO_SELFPROVISION=1 (then falls through to a PATH python).
if [ -z "${AGENT_WORKTREES_NO_SELFPROVISION:-}" ]; then
  mkdir -p "$_awroot" 2>/dev/null || true
  _awstatus="$_awroot/.provision-status"
  _awinstall="$(cat "$_awroot/payload-dir" 2>/dev/null)/scripts/install.sh"
  [ -f "$_awinstall" ] || _awinstall="$(ls "$HOME"/.copilot/installed-plugins/*/agent-worktrees/scripts/install.sh 2>/dev/null | head -n1)"
  if [ -f "$_awinstall" ]; then
    printf '%s\n' "[agent-worktrees] runtime not provisioned -- provisioning on first use (may take ~30-120s: acquires uv + builds a venv). Do not kill; extend your timeout." >&2
    printf '::agent-provisioning:: plugin=agent-worktrees eta_seconds=120 reason=first-use status=%s\n' "$_awstatus" >&2
    # Serialize concurrent first calls where flock is available (POSIX boxes);
    # on git-sh/Windows (no flock) provisioning is idempotent enough to race.
    if command -v flock >/dev/null 2>&1; then
      exec 9>"$_awroot/.provision.lock" 2>/dev/null || true
      flock 9 2>/dev/null || true
      # Re-resolve after acquiring the lock: another process may have finished.
      if [ -f "$_awroot/current-version" ]; then _awver=$(tr -d ' \t\r\n' < "$_awroot/current-version"); _awslot="$_awroot/versions/$_awver"; fi
      [ -n "$_awver" ] && [ -x "$_awslot/bin/agent-worktrees" ] && exec "$_awslot/bin/agent-worktrees" "$@"
    fi
    printf 'provisioning %s\n' "$(date -u +%FT%TZ 2>/dev/null)" > "$_awstatus" 2>/dev/null || true
    # install.sh is bash (self-staging); run it under bash, not this sh.
    bash "$_awinstall" provision >&2
    _awrc=$?
    if [ -f "$_awroot/current-version" ]; then _awver=$(tr -d ' \t\r\n' < "$_awroot/current-version"); _awslot="$_awroot/versions/$_awver"; fi
    if [ "$_awrc" -eq 0 ] && [ -n "$_awver" ] && [ -x "$_awslot/bin/agent-worktrees" ]; then
      printf 'ready %s\n' "$(date -u +%FT%TZ 2>/dev/null)" > "$_awstatus" 2>/dev/null || true
      exec "$_awslot/bin/agent-worktrees" "$@"
    fi
    if [ "$_awrc" -eq 0 ] && [ -n "$_awver" ] && [ -x "$_awslot/Scripts/python.exe" ]; then
      printf 'ready %s\n' "$(date -u +%FT%TZ 2>/dev/null)" > "$_awstatus" 2>/dev/null || true
      exec "$_awslot/Scripts/python.exe" -m agent_worktrees "$@"
    fi
    printf 'failed rc=%s %s\n' "$_awrc" "$(date -u +%FT%TZ 2>/dev/null)" > "$_awstatus" 2>/dev/null || true
    printf '%s\n' "[agent-worktrees] provisioning FAILED (rc=$_awrc). See the log above; retry, or run: bash \"$_awinstall\" provision" >&2
    exit "${_awrc:-1}"
  fi
fi
exec python -m agent_worktrees "$@"
