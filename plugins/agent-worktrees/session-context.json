{
  "schema": "copilot-extensions.session-context-contributors",
  "version": 1,
  "complete": true,
  "contributors": [
    {
      "id": "aggregate-context",
      "pure": true,
      "order": 100,
      "timeoutSeconds": 10,
      "maxBytes": 1600,
      "bash": [
        "scripts/emit-session-context.sh"
      ],
      "powershell": [
        "scripts/emit-session-context.ps1"
      ]
    },
    {
      "id": "command-catalog",
      "pure": true,
      "order": 400,
      "timeoutSeconds": 1,
      "maxBytes": 2048,
      "bash": [
        "scripts/emit-command-catalog.sh"
      ],
      "powershell": [
        "scripts/emit-command-catalog.ps1"
      ]
    }
  ],
  "sessionStart": {
    "sideEffects": "restart-safe-idempotent",
    "context": "authority-aware"
  }
}
