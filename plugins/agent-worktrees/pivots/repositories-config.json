{
  "schema_version": 1,
  "label": "Repositories",
  "placement": "config",
  "scope": "global",
  "list": ["agent-worktrees", "repos", "configuration", "catalog", "--context-project", "{repo}", "--workspace", "{configuration_workspace}"],
  "summary": "{repositories} repositories",
  "entry": {"id": "id", "title": "title", "subtitle": "effective", "badges": ["registration", "participation"]},
  "columns": [
    {"key": "title", "header": "REPOSITORY", "width": 24, "priority": 1},
    {"key": "registration", "header": "REGISTRATION", "width": 14, "priority": 2},
    {"key": "participation", "header": "PARTICIPATION", "width": 16, "priority": 3},
    {"key": "effective", "header": "COPILOT PREFERENCE", "width": 24, "priority": 1},
    {"key": "provenance", "header": "SOURCE", "width": 16, "priority": 4}
  ],
  "empty_hint": "No native repository configuration is available.",
  "actions": [
    {"key": "details", "label": "Inspect effective state / sources / owner boundaries", "kind": "card", "title_from": "card.title", "body_from": "card.body"},
    {
      "key": "create-knowledge", "label": "Create a personal private knowledge repository", "kind": "form",
      "when": {"knowledge_creation_available": "true"}, "fields_from": "knowledge_creation_fields", "body_from": "card.body", "confirm": true,
      "preview": ["agent-worktrees", "repos", "configuration", "knowledge-create-preview", "--context-project", "{context_project}", "--repository-url", "{field.url}"],
      "run": ["agent-worktrees", "repos", "configuration", "knowledge-create-apply", "--context-project", "{context_project}", "--repository-url", "{field.url}", "--preview-token", "{configuration_preview}"]
    },
    {
      "key": "inspect-knowledge-creation", "label": "Inspect prior creation read-only", "kind": "form",
      "when": {"knowledge_creation_recovery_available": "true"}, "fields_from": "knowledge_creation_recovery_fields", "body_from": "card.body",
      "run": ["agent-worktrees", "repos", "configuration", "knowledge-create-inspect", "--context-project", "{context_project}", "--repository-url", "{field.url}", "--creation-receipt", "{field.receipt}"]
    },
    {
      "key": "protect-knowledge", "label": "Complete safeguards for a confirmed creation", "kind": "form",
      "when": {"knowledge_creation_recovery_available": "true"}, "fields_from": "knowledge_creation_recovery_fields", "body_from": "card.body", "confirm": true,
      "preview": ["agent-worktrees", "repos", "configuration", "knowledge-protect-preview", "--context-project", "{context_project}", "--repository-url", "{field.url}", "--creation-receipt", "{field.receipt}"],
      "run": ["agent-worktrees", "repos", "configuration", "knowledge-protect-apply", "--context-project", "{context_project}", "--repository-url", "{field.url}", "--creation-receipt", "{field.receipt}", "--preview-token", "{configuration_preview}"]
    },
    {
      "key": "acquire-knowledge", "label": "Acquire a remote knowledge checkout only", "kind": "form",
      "when": {"knowledge_acquisition_available": "true"}, "fields_from": "knowledge_acquisition_fields", "body_from": "card.body", "confirm": true,
      "preview": ["agent-worktrees", "repos", "configuration", "knowledge-acquire-preview", "--context-project", "{context_project}", "--repository-url", "{field.url}", "--checkout-path", "{field.path}"],
      "run": ["agent-worktrees", "repos", "configuration", "knowledge-acquire-apply", "--context-project", "{context_project}", "--repository-url", "{field.url}", "--checkout-path", "{field.path}", "--preview-token", "{configuration_preview}"]
    },
    {
      "key": "register-local-knowledge", "label": "Register an existing local knowledge checkout", "kind": "form",
      "when": {"knowledge_registration_available": "true"}, "fields_from": "knowledge_registration_fields", "body_from": "card.body", "confirm": true,
      "preview": ["agent-worktrees", "repos", "configuration", "knowledge-register-preview", "--context-project", "{context_project}", "--repository", "{field.name}", "--checkout-path", "{field.path}", "--default-branch", "{field.branch}", "--account={field.account}"],
      "run": ["agent-worktrees", "repos", "configuration", "knowledge-register-apply", "--context-project", "{context_project}", "--repository", "{field.name}", "--checkout-path", "{field.path}", "--default-branch", "{field.branch}", "--account={field.account}", "--preview-token", "{configuration_preview}"]
    },
    {
      "key": "bind-preferred-knowledge", "label": "Bind the accepted knowledge default", "kind": "form",
      "when": {"preferred_knowledge_bindable": "true"}, "fields_from": "binding_fields", "body_from": "card.body", "confirm": true,
      "preview": ["agent-worktrees", "repos", "configuration", "knowledge-preview", "--context-project", "{context_project}", "--harness-id", "{harness_repository_id}", "--knowledge-id", "{knowledge_repository_id}", "--accepted-default"],
      "run": ["agent-worktrees", "repos", "configuration", "knowledge-apply", "--context-project", "{context_project}", "--harness-id", "{harness_repository_id}", "--knowledge-id", "{knowledge_repository_id}", "--accepted-default", "--preview-token", "{configuration_preview}"]
    },
    {
      "key": "bind-knowledge", "label": "Bind this existing knowledge repository", "kind": "form",
      "when": {"knowledge_bindable": "true"}, "fields_from": "binding_fields", "body_from": "card.body", "confirm": true,
      "preview": ["agent-worktrees", "repos", "configuration", "knowledge-preview", "--context-project", "{context_project}", "--repository", "{repository}"],
      "run": ["agent-worktrees", "repos", "configuration", "knowledge-apply", "--context-project", "{context_project}", "--repository", "{repository}", "--preview-token", "{configuration_preview}"]
    },
    {
      "key": "set", "label": "Set future-launch Copilot preference", "kind": "form",
      "when": {"editable": "true"}, "fields_from": "fields", "body_from": "card.body", "confirm": true,
      "preview": ["agent-worktrees", "repos", "configuration", "preview", "--context-project", "{context_project}", "--repository", "{repository}", "--operation", "set", "--login={field.login}"],
      "run": ["agent-worktrees", "repos", "configuration", "apply", "--context-project", "{context_project}", "--repository", "{repository}", "--operation", "set", "--login={field.login}", "--preview-token", "{configuration_preview}"]
    },
    {
      "key": "reset", "label": "Reset local preference / resume inheritance", "kind": "form",
      "when": {"resettable": "true"}, "fields_from": "reset_fields", "body_from": "card.body", "confirm": true,
      "preview": ["agent-worktrees", "repos", "configuration", "preview", "--context-project", "{context_project}", "--repository", "{repository}", "--operation", "reset"],
      "run": ["agent-worktrees", "repos", "configuration", "apply", "--context-project", "{context_project}", "--repository", "{repository}", "--operation", "reset", "--preview-token", "{configuration_preview}"]
    }
  ]
}
