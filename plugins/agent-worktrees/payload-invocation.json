{
  "schema": "copilot-extensions.payload-invocation",
  "version": 2,
  "command": "agent-worktrees",
  "module": "agent_worktrees",
  "legacyRuntimeRoot": ".agent-worktrees",
  "installationContext": "required",
  "catalogBinding": true,
  "catalogBindingModule": "src/agent_worktrees/_command_binding.py",
  "noSelfProvisionEnv": "AGENT_WORKTREES_NO_SELFPROVISION",
  "payloadRootEnv": "AGENT_WORKTREES_PAYLOAD_ROOT",
  "bootTraceLogFile": "logs/activity.jsonl",
  "purpose": "Manage worktrees and project lifecycle",
  "payloadDispatcher": {
    "posix": "scripts/invoke-payload-runtime.sh",
    "windows": "scripts/invoke-payload-runtime.ps1"
  },
  "outputDir": "bin/payload"
}
