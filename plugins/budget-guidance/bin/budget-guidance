#!/usr/bin/env sh
# Generated by libs/payload-invocation/generate.py. Do not edit.
set -eu

export PYTHONUTF8=1
_command="budget-guidance"
_module="budget_guidance"
_self_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
_payload_root="$(CDPATH= cd -- "$_self_dir/.." && pwd -P)"

if [ -n "${COPILOT_PLUGIN_ROOT:-}" ]; then
    _context_root="$(CDPATH= cd -- "$COPILOT_PLUGIN_ROOT" 2>/dev/null && pwd -P)" || {
        printf '[%s] invalid COPILOT_PLUGIN_ROOT: %s\n' "$_command" "$COPILOT_PLUGIN_ROOT" >&2
        exit 126
    }
    if [ "$_context_root" != "$_payload_root" ]; then
        printf '[%s] payload context mismatch: shim=%s context=%s\n' \
            "$_command" "$_payload_root" "$_context_root" >&2
        exit 126
    fi
fi
if [ ! -f "$_payload_root/plugin.json" ]; then
    printf '[%s] payload root is not a plugin: %s\n' "$_command" "$_payload_root" >&2
    exit 126
fi

case "$PWD/" in
    "$_payload_root/"*)
        _outside="${COPILOT_PROJECT_DIR:-$HOME}"
        [ -d "$_outside" ] || _outside="${TMPDIR:-/tmp}"
        cd "$_outside"
        ;;
esac

_runtime_root="$HOME/.budget-guidance"
_resolver="$_payload_root/scripts/resolve-runtime.sh"
_resolve_runtime() {
    AGENT_RT_PY=""
    if [ -f "$_resolver" ]; then
        AGENT_RT_ROOT="$_runtime_root"
        export AGENT_RT_ROOT
        # shellcheck source=/dev/null
        . "$_resolver"
    fi
}

_resolve_runtime
if [ -n "${AGENT_RT_PY:-}" ]; then
    exec "$AGENT_RT_PY" -m "$_module" "$@"
fi
if [ -n "${BUDGET_GUIDANCE_NO_SELFPROVISION:-}" ]; then
    printf '[%s] runtime not provisioned (%s set).\n' \
        "$_command" "BUDGET_GUIDANCE_NO_SELFPROVISION" >&2
    exit 1
fi

mkdir -p "$_runtime_root"
_lock_link=""
_unlock_provision() {
    if [ -n "$_lock_link" ]; then
        _owner="$(readlink "$_lock_link" 2>/dev/null || true)"
        [ "$_owner" = "$$" ] && rm -f "$_lock_link"
        _lock_link=""
    else
        flock -u 9 2>/dev/null || true
        exec 9>&-
    fi
}
if command -v flock >/dev/null 2>&1 && [ "${COPILOT_EXT_NO_FLOCK:-}" != "1" ]; then
    exec 9>"$_runtime_root/.provision.lock"
    flock 9
else
    _lock_link="$_runtime_root/.provision.lock.pid"
    until ln -s "$$" "$_lock_link" 2>/dev/null; do
        _owner="$(readlink "$_lock_link" 2>/dev/null || true)"
        case "$_owner" in
            *[!0-9]*|"") _live=0 ;;
            *) if kill -0 "$_owner" 2>/dev/null; then _live=1; else _live=0; fi ;;
        esac
        if [ "$_live" = "0" ] && [ "$(readlink "$_lock_link" 2>/dev/null || true)" = "$_owner" ]; then
            rm -f "$_lock_link"
        else
            sleep 1
        fi
    done
fi
trap '_unlock_provision' EXIT INT TERM

_resolve_runtime
if [ -n "${AGENT_RT_PY:-}" ]; then
    _unlock_provision
    trap - EXIT INT TERM
    exec "$AGENT_RT_PY" -m "$_module" "$@"
fi

_installer="$_payload_root/scripts/install.sh"
if [ ! -f "$_installer" ]; then
    printf '[%s] payload installer not found: %s\n' "$_command" "$_installer" >&2
    exit 127
fi

printf '[%s] runtime not provisioned -- provisioning from the owning payload.\n' \
    "$_command" >&2
printf '::agent-provisioning:: plugin=%s eta_seconds=120 reason=first-use\n' \
    "$_command" >&2
bash "$_installer" stamp >&2
_snapshot="$(cat "$_runtime_root/payload-dir" 2>/dev/null || true)"
_snapshot_installer="$_snapshot/scripts/install.sh"
if [ ! -f "$_snapshot_installer" ]; then
    printf '[%s] stamped snapshot installer not found: %s\n' \
        "$_command" "$_snapshot_installer" >&2
    exit 127
fi
bash "$_snapshot_installer" provision >&2
_resolve_runtime
if [ -n "${AGENT_RT_PY:-}" ]; then
    _unlock_provision
    trap - EXIT INT TERM
    exec "$AGENT_RT_PY" -m "$_module" "$@"
fi
printf '[%s] provisioning completed without a resolvable runtime.\n' "$_command" >&2
exit 1
