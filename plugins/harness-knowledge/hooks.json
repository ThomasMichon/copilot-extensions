{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "powershell": "$s = (Join-Path (Get-Location).Path 'scripts\\emit-binding.ps1'); if (Test-Path $s) { & $s }",
        "bash": "s=\"$PWD/scripts/emit-binding.sh\"; [ -f \"$s\" ] && bash \"$s\"",
        "timeoutSec": 10
      }
    ]
  }
}
