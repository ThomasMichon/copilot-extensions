{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "powershell": "$s = (Join-Path (Get-Location).Path 'scripts\\bootstrap-check.ps1'); if (-not (Test-Path $s)) { $s = \"$env:USERPROFILE\\.agent-ssh\\bin\\bootstrap-check.ps1\" }; if (Test-Path $s) { & $s }",
        "bash": "s=\"$PWD/scripts/bootstrap-check.sh\"; [ -f \"$s\" ] || s=\"$HOME/.agent-ssh/bin/bootstrap-check.sh\"; [ -f \"$s\" ] && bash \"$s\"",
        "timeoutSec": 15
      },
      {
        "type": "command",
        "powershell": "$s = (Join-Path (Get-Location).Path 'scripts\\emit-mesh-pointer.ps1'); if (-not (Test-Path $s)) { $s = \"$env:USERPROFILE\\.agent-ssh\\bin\\emit-mesh-pointer.ps1\" }; if (Test-Path $s) { & $s }",
        "bash": "s=\"$PWD/scripts/emit-mesh-pointer.sh\"; [ -f \"$s\" ] || s=\"$HOME/.agent-ssh/bin/emit-mesh-pointer.sh\"; [ -f \"$s\" ] && bash \"$s\"",
        "timeoutSec": 10
      }
    ]
  }
}
