{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "powershell": "$r = $env:COPILOT_PLUGIN_ROOT; if (-not $r) { $r = (Get-Location).Path }; $s = (Join-Path $r 'scripts\\readiness-context.ps1'); if (Test-Path $s) { & $s } else { [Console]::Out.Write('{}') }",
        "bash": "r=\"${COPILOT_PLUGIN_ROOT:-$PWD}\"; s=\"$r/scripts/readiness-context.sh\"; if [ -f \"$s\" ]; then bash \"$s\"; else printf '{}'; fi",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "powershell": "$r = $env:COPILOT_PLUGIN_ROOT; if (-not $r) { $r = (Get-Location).Path }; $s = (Join-Path $r 'scripts\\bootstrap-check.ps1'); if (Test-Path $s) { & $s } else { [Console]::Out.Write('{}') }",
        "bash": "r=\"${COPILOT_PLUGIN_ROOT:-$PWD}\"; s=\"$r/scripts/bootstrap-check.sh\"; if [ -f \"$s\" ]; then bash \"$s\"; else printf '{}'; fi",
        "timeoutSec": 15
      },
      {
        "type": "command",
        "powershell": "$r = $env:COPILOT_PLUGIN_ROOT; if (-not $r) { $r = (Get-Location).Path }; $s = (Join-Path $r 'scripts\\emit-command-catalog.ps1'); if (Test-Path $s) { & $s } else { [Console]::Out.Write('{}') }",
        "bash": "r=\"${COPILOT_PLUGIN_ROOT:-$PWD}\"; s=\"$r/scripts/emit-command-catalog.sh\"; if [ -f \"$s\" ]; then bash \"$s\"; else printf '{}'; fi",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "powershell": "$r = $env:COPILOT_PLUGIN_ROOT; if (-not $r) { $r = (Get-Location).Path }; $s = (Join-Path $r 'scripts\\register-bridge-provider.ps1'); if (Test-Path $s) { & $s } else { [Console]::Out.Write('{}') }",
        "bash": "r=\"${COPILOT_PLUGIN_ROOT:-$PWD}\"; s=\"$r/scripts/register-bridge-provider.sh\"; if [ -f \"$s\" ]; then bash \"$s\"; else printf '{}'; fi",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "powershell": "$r = $env:COPILOT_PLUGIN_ROOT; if (-not $r) { $r = (Get-Location).Path }; $s = (Join-Path $r 'scripts\\emit-codespace-map.ps1'); if (Test-Path $s) { & $s } else { [Console]::Out.Write('{}') }",
        "bash": "r=\"${COPILOT_PLUGIN_ROOT:-$PWD}\"; s=\"$r/scripts/emit-codespace-map.sh\"; if [ -f \"$s\" ]; then bash \"$s\"; else printf '{}'; fi",
        "timeoutSec": 10
      }
    ]
  }
}
