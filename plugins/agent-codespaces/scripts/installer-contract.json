{
  "schema": "agent-codespaces.native-installer",
  "version": 2,
  "capabilities": {
    "runtime-only-v1": {
      "actions": ["install", "update"],
      "entrypoints": {
        "install.ps1": "-NoService"
      },
      "required_options": [
        "-WheelProfile",
        "-WheelDirectory",
        "-WheelPython",
        "-WheelUv"
      ],
      "source_qualified_payloads": false,
      "incompatible_options": ["-DryRun"],
      "unsupported_provider": "refuse-runtime-only-before-effects"
    }
  }
}
