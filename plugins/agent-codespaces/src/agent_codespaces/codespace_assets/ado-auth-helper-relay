#!/bin/bash
# ado-auth-helper — Credential helper proxy for SSH-tunneled auth
#
# Drop-in replacement for the VS Code extension's ~/ado-auth-helper when
# connecting via SSH. Proxies requests through the SSH RemoteForward tunnel
# back to the local machine's Git Credential Manager.
#
# Supports all hosts — ADO (your Azure DevOps org host, dev.azure.com) and
# GitHub (github.com) — by relaying to the local GCM which has credentials
# for both. This enables dotfiles repo operations over SSH without manual
# token forwarding.
#
# Supports:
#   get              — Git credential helper mode (reads git-credential-protocol from stdin)
#   get-access-token — Returns a raw ADO access token for non-git tools (npm, nuget)
#
# The SSH session must set LC_GIT_CREDENTIAL_RELAY=<port> and forward
# that port with -R <port>:localhost:<port>.
#
# If no relay is set in the env AND no port-mapping file / default-port forward
# is live (e.g., a plain VS Code session), this helper exits non-zero, letting
# the VS Code extension handle auth.

ACTION="${1:-}"
SCOPE="${2:-}"
DEFAULT_RELAY_PORT=9857
RELAY_PORTS_DIR="$HOME/.agent-bridge/relay-ports"
RELAY_PORT="${LC_GIT_CREDENTIAL_RELAY:-}"
RELAY_TOKEN="${LC_GIT_CREDENTIAL_RELAY_TOKEN:-}"

# On-device token cache (#145/#617). A recently-served BARE token
# (get-access-token, scoped or direct) is cached under RELAY_TOKEN_CACHE_DIR so a
# brief relay outage does not fail an in-flight `rush update` / npm / nuget
# fetch: the credential relay lives on the caller's host, which may sleep (a
# laptop) or briefly drop its -R tunnel. The cache is a FALLBACK only -- a live
# relay is always preferred and refreshes the cache, and a cached token is served
# only while within RELAY_TOKEN_CACHE_TTL seconds (default 1500 = 25 min, well
# under an ADO token's lifetime). Files are written 0600. Git username/password
# `get` is never cached (it relays to GCM cheaply and caching secrets is worse).
RELAY_TOKEN_CACHE_DIR="$HOME/.agent-bridge/token-cache"
RELAY_TOKEN_CACHE_TTL="${LC_GIT_CREDENTIAL_RELAY_CACHE_TTL:-1500}"

# True (0) if a credential-relay channel is accepting on 127.0.0.1:<port>.
_relay_live() { (echo >"/dev/tcp/127.0.0.1/${1:-0}") 2>/dev/null; }

# Port-discovery: if this shell never inherited LC_GIT_CREDENTIAL_RELAY, or the
# inherited port's channel is dead (a since-torn-down forward), find a working
# relay from the port-mapping files the launch prelude publishes under
# RELAY_PORTS_DIR. Probe each recorded port for a live channel, adopt the first
# that accepts (plus its token/host), and prune a dead channel's stale mapping.
# This is how a dispatched tool shell finds an active channel back to the caller
# (dotfiles #489/#187/#19). Falls through to the legacy default-port probe.
if [ -z "$RELAY_PORT" ] || ! _relay_live "$RELAY_PORT"; then
    _disc="$(python3 - "$RELAY_PORTS_DIR" <<'PY'
import glob, json, os, socket, sys

d = sys.argv[1]
files = sorted(glob.glob(os.path.join(d, "*.json")),
               key=os.path.getmtime, reverse=True)
for f in files:
    try:
        with open(f) as fh:
            m = json.load(fh)
        port = int(m["port"])
    except Exception:
        continue
    s = socket.socket()
    s.settimeout(0.5)
    try:
        s.connect(("127.0.0.1", port))
    except OSError:
        try:
            os.unlink(f)  # prune a dead channel's stale mapping
        except OSError:
            pass
        continue
    finally:
        s.close()
    print("%d\t%s\t%s" % (port, m.get("token", ""), m.get("ado_host", "")))
    sys.exit(0)
sys.exit(1)
PY
)"
    if [ -n "$_disc" ]; then
        IFS=$'\t' read -r _dport _dtoken _dhost <<< "$_disc"
        RELAY_PORT="$_dport"
        [ -z "$RELAY_TOKEN" ] && RELAY_TOKEN="$_dtoken"
        if [ -z "${LC_GIT_CREDENTIAL_RELAY_ADO_HOST:-}" ] && [ -n "$_dhost" ]; then
            export LC_GIT_CREDENTIAL_RELAY_ADO_HOST="$_dhost"
        fi
    fi
fi

# Final fallback: probe the legacy default port (a codespace-ssh session may
# have a RemoteForward active even without an env var or mapping file).
if [ -z "$RELAY_PORT" ]; then
    if _relay_live "$DEFAULT_RELAY_PORT"; then
        RELAY_PORT="$DEFAULT_RELAY_PORT"
    elif [ "$ACTION" = "get-access-token" ]; then
        # No live relay reachable. For a BARE-token request, fall through with an
        # empty port so the on-device cache fallback below can serve a recently
        # cached token across a brief relay outage (the relay host may be asleep
        # or its tunnel briefly down). Git `get` keeps failing fast (exit 1).
        RELAY_PORT=""
    else
        exit 1
    fi
fi

case "$ACTION" in
    get)
        # Git credential helper mode — read stdin, proxy through relay
        exec python3 -c "
import socket, sys

port = int(sys.argv[1])
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.settimeout(10)

try:
    s.connect(('localhost', port))

    # Read stdin until blank line (git credential protocol terminator)
    lines = []
    for line in sys.stdin:
        lines.append(line)
        if line.strip() == '':
            break
    stdin_data = ''.join(lines)

    # Send through relay (no action prefix — server defaults to 'get')
    request = stdin_data
    if not request.endswith('\n\n'):
        request = request.rstrip('\n') + '\n\n'

    s.sendall(request.encode('utf-8'))

    # Read response until blank line or EOF
    s.settimeout(30)
    response = b''
    while True:
        chunk = s.recv(4096)
        if not chunk:
            break
        response += chunk
        if b'\n\n' in response:
            break

    sys.stdout.buffer.write(response)
    sys.stdout.buffer.flush()
except Exception:
    sys.exit(1)
finally:
    s.close()
" "$RELAY_PORT"
        ;;

    get-access-token)
        # ADO host discovery for the DIRECT (non-scoped) token (never hardcoded):
        #   1. LC_GIT_CREDENTIAL_RELAY_ADO_HOST (explicit, plumbed by connect)
        #   2. the workspace's git remotes (the ADO host of the checked-out repo)
        # If none is found, fall through host-less and let the relay server apply
        # its own configured default (#64).
        ADO_HOST="${LC_GIT_CREDENTIAL_RELAY_ADO_HOST:-}"
        if [ -z "$ADO_HOST" ] && [ -z "$SCOPE" ]; then
            ADO_HOST="$(git -C "${VM_REPO_PATH:-$PWD}" remote -v 2>/dev/null \
                | grep -oiE '([A-Za-z0-9_-]+\.visualstudio\.com|dev\.azure\.com)' \
                | head -n1)"
        fi
        # Scoped (Azure AAD) mode routes to the gated get-azure-token action;
        # direct mode returns a raw ADO token for npm/nuget/rush. Both are
        # cache-backed: a live relay is preferred and refreshes the cache; a
        # recently-cached token is served only when the relay is unreachable.
        if [ -n "$SCOPE" ]; then
            _MODE="azure"; _KEYMAT="$SCOPE"
        else
            _MODE="access"; _KEYMAT="$ADO_HOST"
        fi
        python3 - "$RELAY_PORT" "$_MODE" "$_KEYMAT" "$RELAY_TOKEN" \
                  "$RELAY_TOKEN_CACHE_DIR" "$RELAY_TOKEN_CACHE_TTL" <<'PY'
import hashlib, os, socket, sys, time

port_s, mode, keymat, auth, cache_dir, ttl_s = sys.argv[1:7]
port = int(port_s) if port_s.strip().isdigit() else 0
ttl = float(ttl_s) if ttl_s else 0.0


def _cache_file():
    key = hashlib.sha256(("%s|%s" % (mode, keymat)).encode()).hexdigest()[:32]
    return os.path.join(cache_dir, key + ".tok")


def _read_cache():
    try:
        with open(_cache_file()) as fh:
            ts = float(fh.readline().strip())
            tok = fh.readline().strip()
    except (OSError, ValueError):
        return ""
    if ttl > 0 and (time.time() - ts) > ttl:
        return ""  # expired: never serve a stale token past the TTL
    return tok


def _write_cache(tok):
    if ttl <= 0 or not tok:
        return
    try:
        os.makedirs(cache_dir, exist_ok=True)
        prev = os.umask(0o177)  # 0600 -- the token is a bearer secret
        try:
            with open(_cache_file(), "w") as fh:
                fh.write("%d\n%s\n" % (int(time.time()), tok))
        finally:
            os.umask(prev)
    except OSError:
        pass


def _fetch():
    if not port:
        return ""  # no live relay -- go straight to the cache fallback
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(10)
    try:
        s.connect(("localhost", port))
        if mode == "azure":
            lines = ["get-azure-token", "scope=" + keymat]
            if auth:
                lines.append("auth=" + auth)
            request = "\n".join(lines) + "\n\n"
        else:
            request = "get-access-token\n"
            if keymat:
                request += "host=" + keymat + "\n"
            request += "\n"
        s.sendall(request.encode("utf-8"))
        s.settimeout(30)
        resp = b""
        while True:
            chunk = s.recv(4096)
            if not chunk:
                break
            resp += chunk
            if b"\n\n" in resp:
                break
    except OSError:
        return ""
    finally:
        s.close()
    text = resp.decode("utf-8", "replace")
    if mode == "azure":
        for line in text.splitlines():
            if line.startswith("token="):
                return line[len("token="):].strip()
        return ""
    return text.strip()


tok = _fetch()
if tok:
    _write_cache(tok)          # refresh the cache on every live success
    sys.stdout.write(tok + "\n")
    sys.exit(0)
cached = _read_cache()          # relay unreachable -> serve a fresh-enough cache
if cached:
    sys.stdout.write(cached + "\n")
    sys.exit(0)
sys.exit(1)
PY
        exit $?
        ;;

    *)
        # store/erase — acknowledge silently
        exit 0
        ;;
esac
