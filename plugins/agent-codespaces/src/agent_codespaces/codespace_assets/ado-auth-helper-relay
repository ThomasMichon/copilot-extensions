#!/bin/bash
# ado-auth-helper — Credential helper proxy for SSH-tunneled auth
#
# Drop-in replacement for the VS Code extension's ~/ado-auth-helper when
# connecting via SSH. Proxies requests through the SSH RemoteForward tunnel
# back to the local machine's Git Credential Manager.
#
# Supports all hosts — ADO (your Azure DevOps org host, dev.azure.com) and
# GitHub (github.com) — by relaying to the local GCM which has credentials
# for both. This enables dotfiles repo operations over SSH without manual
# token forwarding.
#
# Supports:
#   get              — Git credential helper mode (reads git-credential-protocol from stdin)
#   get-access-token — Returns a raw ADO access token for non-git tools (npm, nuget)
#
# The SSH session must set LC_GIT_CREDENTIAL_RELAY=<port> and forward
# that port with -R <port>:localhost:<port>.
#
# If no relay is set in the env AND no port-mapping file / default-port forward
# is live (e.g., a plain VS Code session), this helper exits non-zero, letting
# the VS Code extension handle auth.

ACTION="${1:-}"
SCOPE="${2:-}"
HELPER_NAME="${LC_GIT_CREDENTIAL_RELAY_HELPER:-}"
ADO_REST_RESOURCE="499b84ac-1321-427f-aa17-267ca6975798"
DEFAULT_RELAY_PORT=9857
RELAY_PORTS_DIR="$HOME/.agent-bridge/relay-ports"
RELAY_PORT="${LC_GIT_CREDENTIAL_RELAY:-}"
RELAY_TOKEN="${LC_GIT_CREDENTIAL_RELAY_TOKEN:-}"

# On-device short-TTL cache (#145/#617/#733). Recently-served borrowed
# credentials are cached under RELAY_TOKEN_CACHE_DIR so a brief relay outage does
# not fail an in-flight `rush update` / npm / nuget fetch or a headless `git
# fetch`/`git push`: the credential relay lives on the caller's host, which may
# sleep or briefly drop its -R tunnel. The cache is a FALLBACK only -- a live
# relay is always preferred and refreshes the cache, and a cached credential is
# served only while within RELAY_TOKEN_CACHE_TTL seconds (default 1500 = 25 min).
# Files are written 0600.
RELAY_TOKEN_CACHE_DIR="$HOME/.agent-bridge/token-cache"
RELAY_TOKEN_CACHE_TTL="${LC_GIT_CREDENTIAL_RELAY_CACHE_TTL:-1500}"

# True (0) if a credential-relay channel accepts TCP on 127.0.0.1:<port>.
_relay_connects() {
    local _p="${1:-0}"
    [[ "$_p" =~ ^[0-9]+$ ]] || return 1
    { exec 9<>"/dev/tcp/127.0.0.1/${_p}"; } 2>/dev/null || return 1
    exec 9<&- 9>&- 2>/dev/null || true
}

# Port-discovery: if this shell never inherited LC_GIT_CREDENTIAL_RELAY, or the
# inherited port's channel is dead (a since-torn-down forward), find a working
# relay from the port-mapping files the launch prelude publishes under
# RELAY_PORTS_DIR. Prefer a serving relay that answers ping, otherwise adopt the
# first TCP-connectable candidate (older relays do not answer ping), and prune
# only a genuinely dead channel's stale mapping.
# This is how a dispatched tool shell finds an active channel back to the caller
# (dotfiles #489/#187/#19). Falls through to the legacy default-port probe.
if [ -z "$RELAY_PORT" ] || ! _relay_connects "$RELAY_PORT"; then
    _disc="$(python3 - "$RELAY_PORTS_DIR" <<'PY'
import glob, json, os, socket, sys

PING_TIMEOUT = float(os.environ.get("LC_GIT_CREDENTIAL_RELAY_PING_TIMEOUT", "1.5"))


def relay_probe(port):
    s = socket.socket()
    s.settimeout(PING_TIMEOUT)
    try:
        s.connect(("127.0.0.1", port))
        s.sendall(b"ping\n\n")
        data = b""
        while b"\n\n" not in data and len(data) < 64:
            chunk = s.recv(64)
            if not chunk:
                break
            data += chunk
        return "pong" if data.splitlines()[0:1] == [b"pong"] else "connect"
    except OSError:
        return "dead"
    finally:
        s.close()

d = sys.argv[1]
files = sorted(glob.glob(os.path.join(d, "*.json")),
               key=os.path.getmtime, reverse=True)
fallback = None
for f in files:
    try:
        with open(f) as fh:
            m = json.load(fh)
        port = int(m["port"])
    except Exception:
        continue
    state = relay_probe(port)
    if state == "dead":
        try:
            os.unlink(f)  # prune a dead channel's stale mapping
        except OSError:
            pass
        continue
    line = "%d\t%s\t%s" % (port, m.get("token", ""), m.get("ado_host", ""))
    if state == "pong":
        print(line)
        sys.exit(0)
    if fallback is None:
        fallback = line
if fallback is not None:
    print(fallback)
    sys.exit(0)
sys.exit(1)
PY
)"
    if [ -n "$_disc" ]; then
        IFS=$'\t' read -r _dport _dtoken _dhost <<< "$_disc"
        RELAY_PORT="$_dport"
        [ -z "$RELAY_TOKEN" ] && RELAY_TOKEN="$_dtoken"
        if [ -z "${LC_GIT_CREDENTIAL_RELAY_ADO_HOST:-}" ] && [ -n "$_dhost" ]; then
            export LC_GIT_CREDENTIAL_RELAY_ADO_HOST="$_dhost"
        fi
    fi
fi

# Final fallback: probe the legacy default port (a codespace-ssh session may
# have a RemoteForward active even without an env var or mapping file).
if [ -z "$RELAY_PORT" ]; then
    if _relay_connects "$DEFAULT_RELAY_PORT"; then
        RELAY_PORT="$DEFAULT_RELAY_PORT"
    elif [ "$ACTION" = "get-access-token" ] || [ "$ACTION" = "get" ]; then
        # No live relay reachable. For a cache-backed request, fall through with
        # an empty port so the on-device cache fallback below can serve a
        # recently cached credential across a brief relay outage (the relay host
        # may be asleep or its tunnel briefly down).
        RELAY_PORT=""
    else
        exit 1
    fi
fi

case "$ACTION" in
    get)
        # Git credential helper mode -- relay always preferred. On a successful
        # live relay fetch, refresh the short-TTL cache keyed by
        # protocol|host|username and return the relay response. Only when the
        # relay is unreachable do we serve a fresh-enough cached response.
        python3 -c '
import hashlib, os, socket, sys, time

port_s, cache_dir, ttl_s = sys.argv[1:4]
port = int(port_s) if port_s.strip().isdigit() else 0
ttl = float(ttl_s) if ttl_s else 0.0


def _read_stdin():
    lines = []
    for line in sys.stdin:
        lines.append(line)
        if line.strip() == "":
            break
    data = "".join(lines)
    if not data.endswith("\n\n"):
        data = data.rstrip("\n") + "\n\n"
    return data


stdin_data = _read_stdin()


def _request_fields(data):
    fields = {}
    for line in data.splitlines():
        if not line.strip():
            break
        if "=" in line:
            k, v = line.split("=", 1)
            fields[k] = v
    return fields


fields = _request_fields(stdin_data)


def _cache_file():
    keymat = "%s|%s|%s" % (
        fields.get("protocol", ""),
        fields.get("host", ""),
        fields.get("username", ""),
    )
    key = hashlib.sha256(("git|" + keymat).encode()).hexdigest()[:32]
    return os.path.join(cache_dir, key + ".gitcred")


def _read_cache():
    try:
        with open(_cache_file()) as fh:
            ts = float(fh.readline().strip())
            response = fh.read()
    except (OSError, ValueError):
        return ""
    if ttl > 0 and (time.time() - ts) > ttl:
        return ""  # expired: never serve a stale credential past the TTL
    return response


def _write_cache(response):
    if ttl <= 0 or not response:
        return
    try:
        os.makedirs(cache_dir, exist_ok=True)
        prev = os.umask(0o177)  # 0600 -- the credential response is a secret
        try:
            with open(_cache_file(), "w") as fh:
                fh.write("%d\n" % int(time.time()))
                fh.write(response)
        finally:
            os.umask(prev)
    except OSError:
        pass


def _fetch():
    if not port:
        return ""  # no live relay -- go straight to the cache fallback
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(10)
    try:
        s.connect(("localhost", port))
        s.sendall(stdin_data.encode("utf-8"))
        s.settimeout(30)
        response = b""
        while True:
            chunk = s.recv(4096)
            if not chunk:
                break
            response += chunk
            if b"\n\n" in response:
                break
    except OSError:
        return ""
    finally:
        s.close()
    text = response.decode("utf-8", "replace")
    if not text.strip() or "quit=1" in text.splitlines():
        return ""
    return text


resp = _fetch()
if resp:
    _write_cache(resp)          # refresh the cache on every live success
    sys.stdout.write(resp)
    sys.exit(0)
cached = _read_cache()          # relay unreachable -> fresh-enough cache only
if cached:
    print(
        "ado-auth-helper: relay unreachable; served git credential from short-TTL cache",
        file=sys.stderr,
    )
    sys.stdout.write(cached)
    sys.exit(0)
sys.exit(1)
' "$RELAY_PORT" "$RELAY_TOKEN_CACHE_DIR" "$RELAY_TOKEN_CACHE_TTL"
        exit $?
        ;;

    get-access-token)
        # The relay wrapper is installed as both ado-auth-helper and
        # azure-auth-helper. Preserve the historical ADO helper behavior for
        # package/feed clients (no scope -> direct ADO host token), but make an
        # unscoped azure-auth-helper request useful for ADO REST clients by
        # defaulting it to the public ADO resource. Explicit scopes/resources
        # still win and are checked by the host-side allowlist.
        if [ -z "$SCOPE" ] && [ "$HELPER_NAME" = "azure-auth-helper" ]; then
            SCOPE="$ADO_REST_RESOURCE"
        fi

        # ADO host discovery for the DIRECT (non-scoped) token (never hardcoded):
        #   1. LC_GIT_CREDENTIAL_RELAY_ADO_HOST (explicit, plumbed by connect)
        #   2. the workspace's git remotes (the ADO host of the checked-out repo)
        # If none is found, fall through host-less and let the relay server apply
        # its own configured default (#64).
        ADO_HOST="${LC_GIT_CREDENTIAL_RELAY_ADO_HOST:-}"
        if [ -z "$ADO_HOST" ] && [ -z "$SCOPE" ]; then
            ADO_HOST="$(git -C "${VM_REPO_PATH:-$PWD}" remote -v 2>/dev/null \
                | grep -oiE '([A-Za-z0-9_-]+\.visualstudio\.com|dev\.azure\.com)' \
                | head -n1)"
        fi
        # Scoped (Azure AAD) mode routes to the gated get-azure-token action;
        # direct mode returns a raw ADO token for npm/nuget/rush. Both are
        # cache-backed: a live relay is preferred and refreshes the cache; a
        # recently-cached token is served only when the relay is unreachable.
        if [ -n "$SCOPE" ]; then
            _MODE="azure"; _KEYMAT="$SCOPE"
        else
            _MODE="access"; _KEYMAT="$ADO_HOST"
        fi
        python3 - "$RELAY_PORT" "$_MODE" "$_KEYMAT" "$RELAY_TOKEN" \
                  "$RELAY_TOKEN_CACHE_DIR" "$RELAY_TOKEN_CACHE_TTL" <<'PY'
import hashlib, os, socket, sys, time

port_s, mode, keymat, auth, cache_dir, ttl_s = sys.argv[1:7]
port = int(port_s) if port_s.strip().isdigit() else 0
ttl = float(ttl_s) if ttl_s else 0.0


def _cache_file():
    key = hashlib.sha256(("%s|%s" % (mode, keymat)).encode()).hexdigest()[:32]
    return os.path.join(cache_dir, key + ".tok")


def _read_cache():
    try:
        with open(_cache_file()) as fh:
            ts = float(fh.readline().strip())
            tok = fh.readline().strip()
    except (OSError, ValueError):
        return ""
    if ttl > 0 and (time.time() - ts) > ttl:
        return ""  # expired: never serve a stale token past the TTL
    return tok


def _write_cache(tok):
    if ttl <= 0 or not tok:
        return
    try:
        os.makedirs(cache_dir, exist_ok=True)
        prev = os.umask(0o177)  # 0600 -- the token is a bearer secret
        try:
            with open(_cache_file(), "w") as fh:
                fh.write("%d\n%s\n" % (int(time.time()), tok))
        finally:
            os.umask(prev)
    except OSError:
        pass


def _fetch():
    if not port:
        return ""  # no live relay -- go straight to the cache fallback
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(10)
    try:
        s.connect(("localhost", port))
        if mode == "azure":
            lines = ["get-azure-token", "scope=" + keymat]
            if auth:
                lines.append("auth=" + auth)
            request = "\n".join(lines) + "\n\n"
        else:
            request = "get-access-token\n"
            if keymat:
                request += "host=" + keymat + "\n"
            request += "\n"
        s.sendall(request.encode("utf-8"))
        s.settimeout(30)
        resp = b""
        while True:
            chunk = s.recv(4096)
            if not chunk:
                break
            resp += chunk
            if b"\n\n" in resp:
                break
    except OSError:
        return ""
    finally:
        s.close()
    text = resp.decode("utf-8", "replace")
    if mode == "azure":
        for line in text.splitlines():
            if line.startswith("token="):
                return line[len("token="):].strip()
        return ""
    return text.strip()


tok = _fetch()
if tok:
    _write_cache(tok)          # refresh the cache on every live success
    sys.stdout.write(tok + "\n")
    sys.exit(0)
cached = _read_cache()          # relay unreachable -> serve a fresh-enough cache
if cached:
    sys.stdout.write(cached + "\n")
    sys.exit(0)
sys.exit(1)
PY
        exit $?
        ;;

    *)
        # store/erase — acknowledge silently
        exit 0
        ;;
esac
