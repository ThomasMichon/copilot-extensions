{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable agent topology",
  "description": "Private assignment intent and dated observations, not a custody ledger or authority grant.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "revision", "dispatcher", "observationMaxAgeSeconds", "machines", "roles", "assignments", "observations"],
  "properties": {
    "version": {"const": 1, "type": "integer"},
    "id": {"$ref": "#/$defs/text"},
    "revision": {"type": "integer", "minimum": 1},
    "dispatcher": {"$ref": "#/$defs/dispatcher"},
    "observationMaxAgeSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "machines": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/machine"}},
    "roles": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/role"}},
    "assignments": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/assignment"}},
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery", "dispatcher", "machines", "owners"],
      "properties": {
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observedAt", "sourceRef", "complete"],
          "properties": {
            "observedAt": {"$ref": "#/$defs/text"},
            "sourceRef": {"$ref": "#/$defs/text"},
            "complete": {"type": "boolean"}
          }
        },
        "dispatcher": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["observedAt", "sourceRef", "owner", "custody"],
          "properties": {
            "observedAt": {"$ref": "#/$defs/text"},
            "sourceRef": {"$ref": "#/$defs/text"},
            "owner": {"$ref": "#/$defs/owner"},
            "custody": {"enum": ["exclusive", "conflict", "unknown"]}
          }
        },
        "machines": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/machineObservation"}},
        "owners": {"type": "array", "maxItems": 4000, "items": {"$ref": "#/$defs/ownerObservation"}},
        "dispatch": {
          "type": "array",
          "maxItems": 4000,
          "description": "Optional. Present only when the adopter uses native Dispatch standing charters; then standing assignments with nativeTask take coverage and routes from this evidence alone.",
          "items": {"$ref": "#/$defs/dispatchObservation"}
        }
      }
    }
  },
  "$defs": {
    "dispatcher": {
      "type": ["object", "null"],
      "description": "Null until a native dispatcher owner is appointed; placement, routes and effects then hold.",
      "additionalProperties": false,
      "required": ["owner", "charter"],
      "properties": {
        "owner": {"$ref": "#/$defs/owner"},
        "charter": {"$ref": "#/$defs/charter"}
      }
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "source", "effective", "sourceRevision", "materializationRevision", "advisoryOnly", "effectAuthorityGranted"],
      "properties": {
        "schema": {"const": "agent-roles.charter-materialization", "type": "string"},
        "version": {"const": 1, "type": "integer"},
        "sourceRevision": {"$ref": "#/$defs/text"},
        "materializationRevision": {"$ref": "#/$defs/text"},
        "advisoryOnly": {"const": true, "type": "boolean"},
        "effectAuthorityGranted": {"const": false, "type": "boolean"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["topology", "topologyRevision", "id", "requestId", "creationKey", "kind", "role", "machine"],
          "properties": {
            "topology": {"$ref": "#/$defs/text"},
            "topologyRevision": {"type": "integer", "minimum": 1},
            "id": {"$ref": "#/$defs/text"},
            "requestId": {"$ref": "#/$defs/text"},
            "creationKey": {"$ref": "#/$defs/text"},
            "kind": {"enum": ["standing", "temporary"]},
            "role": {"$ref": "#/$defs/text"},
            "machine": {"$ref": "#/$defs/text"}
          }
        },
        "effective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["charter", "role", "machine", "dispatcher"],
          "properties": {
            "charter": {"$ref": "#/$defs/charter"},
            "role": {"$ref": "#/$defs/role"},
            "machine": {"$ref": "#/$defs/machine"},
            "dispatcher": {"$ref": "#/$defs/dispatcher"}
          }
        }
      }
    },
    "text": {"type": "string", "minLength": 1, "maxLength": 32768},
    "texts": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "nullableText": {"type": ["string", "null"], "minLength": 1, "maxLength": 32768},
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machine", "project", "worktree"],
      "properties": {
        "machine": {"$ref": "#/$defs/text"},
        "project": {"$ref": "#/$defs/text"},
        "worktree": {"$ref": "#/$defs/text"}
      }
    },
    "charter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "authorityRef", "objective", "scope", "acceptance", "permittedActions", "exclusions", "resourceLimits", "supervision", "exitPolicy"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "authorityRef": {"$ref": "#/$defs/text"},
        "objective": {"$ref": "#/$defs/text"},
        "scope": {"$ref": "#/$defs/text"},
        "acceptance": {"$ref": "#/$defs/text"},
        "permittedActions": {"$ref": "#/$defs/text"},
        "exclusions": {"$ref": "#/$defs/text"},
        "resourceLimits": {"$ref": "#/$defs/text"},
        "supervision": {"$ref": "#/$defs/text"},
        "exitPolicy": {"$ref": "#/$defs/text"}
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "registryRef", "purpose", "allowedRoles", "allowedKinds", "capabilities", "capacitySlots", "constraints"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "registryRef": {"$ref": "#/$defs/text"},
        "purpose": {"$ref": "#/$defs/text"},
        "allowedRoles": {"$ref": "#/$defs/texts"},
        "allowedKinds": {"type": "array", "uniqueItems": true, "maxItems": 2, "items": {"enum": ["standing", "temporary"]}},
        "capabilities": {"$ref": "#/$defs/texts"},
        "capacitySlots": {"type": ["integer", "null"], "minimum": 0},
        "constraints": {"$ref": "#/$defs/texts"}
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "meaning", "scope", "minimum", "requiredCapabilities", "constraints"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "meaning": {"$ref": "#/$defs/text"},
        "scope": {"$ref": "#/$defs/text"},
        "minimum": {"type": "integer", "minimum": 0},
        "requiredCapabilities": {"$ref": "#/$defs/texts"},
        "constraints": {"$ref": "#/$defs/texts"}
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requestId", "kind", "role", "machine", "state", "creationKey", "charter", "nativeWorktree", "nativeTask", "effects", "followups"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "requestId": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["standing", "temporary"]},
        "role": {"$ref": "#/$defs/text"},
        "machine": {"$ref": "#/$defs/text"},
        "state": {"enum": ["proposed", "active", "completed", "released"]},
        "creationKey": {"$ref": "#/$defs/text"},
        "charter": {"$ref": "#/$defs/charter"},
        "nativeWorktree": {"type": ["object", "null"], "additionalProperties": false, "required": ["machine", "project", "worktree"], "properties": {"machine": {"$ref": "#/$defs/text"}, "project": {"$ref": "#/$defs/text"}, "worktree": {"$ref": "#/$defs/text"}}},
        "nativeTask": {"$ref": "#/$defs/nullableText"},
        "effects": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/effect"}},
        "followups": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/followup"}}
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "state", "charterRevision", "target", "nativeRequest", "nativeRef"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["allocate", "launch", "relay", "retire"]},
        "state": {"enum": ["prepared", "unknown", "admitted", "consumed", "accepted", "confirmed", "failed"]},
        "charterRevision": {"type": "integer", "minimum": 1},
        "target": {"type": ["object", "null"], "additionalProperties": false, "required": ["machine", "project", "worktree"], "properties": {"machine": {"$ref": "#/$defs/text"}, "project": {"$ref": "#/$defs/text"}, "worktree": {"$ref": "#/$defs/text"}}},
        "nativeRequest": {
          "type": ["object", "null"],
          "description": "Required for message effects: the selected native mode and an immutable, version-addressed private envelope saved before the effect. The helper does not dereference or authenticate it.",
          "additionalProperties": false,
          "required": ["mode", "envelopeRef"],
          "properties": {
            "mode": {"$ref": "#/$defs/text"},
            "envelopeRef": {"$ref": "#/$defs/text"}
          }
        },
        "nativeRef": {"$ref": "#/$defs/nullableText"}
      }
    },
    "followup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "content", "charterRevision", "effectId"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["status", "adjustment"]},
        "content": {"$ref": "#/$defs/text"},
        "charterRevision": {"type": "integer", "minimum": 1},
        "effectId": {"$ref": "#/$defs/nullableText"}
      }
    },
    "machineObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machine", "observedAt", "sourceRef", "state", "usedSlots"],
      "properties": {
        "machine": {"$ref": "#/$defs/text"},
        "observedAt": {"$ref": "#/$defs/text"},
        "sourceRef": {"$ref": "#/$defs/text"},
        "state": {"enum": ["ready", "unreachable", "unknown"]},
        "usedSlots": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "ownerObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "head", "observedAt", "sourceRef", "state", "assignmentId", "role", "scope", "acceptedCharterRevision", "acceptanceRef"],
      "properties": {
        "owner": {"$ref": "#/$defs/owner"},
        "head": {"$ref": "#/$defs/nullableText"},
        "headRevision": {"type": ["integer", "null"], "minimum": 0},
        "observedAt": {"$ref": "#/$defs/text"},
        "sourceRef": {"$ref": "#/$defs/text"},
        "state": {"enum": ["running", "idle", "waiting", "dormant", "completed", "unreachable", "unknown"]},
        "assignmentId": {"$ref": "#/$defs/nullableText"},
        "role": {"$ref": "#/$defs/nullableText"},
        "scope": {"$ref": "#/$defs/nullableText"},
        "acceptedCharterRevision": {"type": ["integer", "null"], "minimum": 1},
        "acceptanceRef": {"$ref": "#/$defs/nullableText"},
        "progress": {"$ref": "#/$defs/progressObservation"}
      }
    },
    "progressObservation": {
      "type": ["object", "null"],
      "description": "Optional dated evidence of the owner's current work, separate from presence and acceptance. It is reported beside coverage and never qualifies, routes or grants anything.",
      "additionalProperties": false,
      "required": ["observedAt", "sourceRef", "state", "workRef", "lastAdvancedAt", "blockingOwner"],
      "properties": {
        "observedAt": {"$ref": "#/$defs/text"},
        "sourceRef": {"$ref": "#/$defs/text"},
        "state": {"enum": ["advancing", "waiting", "blocked", "complete", "unknown"]},
        "workRef": {"$ref": "#/$defs/nullableText"},
        "lastAdvancedAt": {"$ref": "#/$defs/nullableText"},
        "blockingOwner": {"$ref": "#/$defs/nullableText"}
      }
    },
    "dispatchObservation": {
      "type": "object",
      "description": "A dated read-only copy of one native standing-charter task and its original relationship. Native fields keep upstream names; other upstream task fields are retained but not interpreted.",
      "additionalProperties": false,
      "required": ["observedAt", "sourceRef", "task", "relationship"],
      "properties": {
        "observedAt": {"$ref": "#/$defs/text"},
        "sourceRef": {"$ref": "#/$defs/text"},
        "task": {"$ref": "#/$defs/nativeStandingTask"},
        "relationship": {"$ref": "#/$defs/nativeRelationship"}
      }
    },
    "nativeStandingTask": {
      "type": "object",
      "required": ["id", "kind", "status", "owner", "owner_session_id", "generation", "hold_reason", "standing_revision", "standing_charter"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "kind": {"const": "standing-charter", "type": "string"},
        "status": {"$ref": "#/$defs/text"},
        "owner": {"$ref": "#/$defs/nullableText"},
        "owner_session_id": {"$ref": "#/$defs/nullableText"},
        "generation": {"type": "integer", "minimum": 0},
        "hold_reason": {"$ref": "#/$defs/nullableText"},
        "standing_revision": {"type": "integer", "minimum": 0},
        "standing_charter": {
          "type": "object",
          "required": ["version", "declaration", "declaration_generation", "lifecycle", "accepted_materialization"],
          "properties": {
            "version": {"const": 1, "type": "integer"},
            "declaration": {
              "type": "object",
              "required": ["materialization_ref", "source_revision", "expected_materialization_revision"],
              "properties": {
                "materialization_ref": {"$ref": "#/$defs/text"},
                "source_revision": {"$ref": "#/$defs/text"},
                "expected_materialization_revision": {"$ref": "#/$defs/text"}
              }
            },
            "declaration_generation": {"type": "integer", "minimum": 1},
            "lifecycle": {"$ref": "#/$defs/text"},
            "accepted_materialization": {"$ref": "#/$defs/nativeAcceptance"}
          }
        }
      }
    },
    "nativeAcceptance": {
      "type": ["object", "null"],
      "required": ["version", "head", "request_id", "assignment_event_id", "relationship_ref", "materialization_ref", "source_revision", "materialization_revision", "expected_revision", "expected_generation", "assignment_generation", "generation"],
      "properties": {
        "version": {"const": 1, "type": "integer"},
        "head": {
          "type": "object",
          "required": ["session_id", "revision"],
          "properties": {
            "session_id": {"$ref": "#/$defs/text"},
            "revision": {"type": "integer", "minimum": 0},
            "predecessor_session_id": {"$ref": "#/$defs/text"}
          }
        },
        "request_id": {"$ref": "#/$defs/text"},
        "assignment_event_id": {"type": "integer", "minimum": 1},
        "relationship_ref": {"$ref": "#/$defs/text"},
        "materialization_ref": {"$ref": "#/$defs/text"},
        "source_revision": {"$ref": "#/$defs/text"},
        "materialization_revision": {"$ref": "#/$defs/text"},
        "expected_revision": {"type": "integer", "minimum": 0},
        "expected_generation": {"type": "integer", "minimum": 0},
        "assignment_generation": {"type": "integer", "minimum": 0},
        "generation": {"type": "integer", "minimum": 0}
      }
    },
    "nativeRelationship": {
      "type": ["object", "null"],
      "required": ["request", "state", "receipt"],
      "properties": {
        "request": {
          "type": "object",
          "required": ["request_id", "event_id", "task_id", "generation", "workspace"],
          "properties": {
            "request_id": {"$ref": "#/$defs/text"},
            "event_id": {"type": "integer", "minimum": 1},
            "task_id": {"$ref": "#/$defs/text"},
            "generation": {"type": "integer", "minimum": 0},
            "workspace": {
              "type": "object",
              "required": ["machine", "project", "worktree"],
              "properties": {
                "machine": {"$ref": "#/$defs/text"},
                "project": {"$ref": "#/$defs/text"},
                "worktree": {"$ref": "#/$defs/text"}
              }
            }
          }
        },
        "state": {"$ref": "#/$defs/text"},
        "receipt": {
          "type": ["object", "null"],
          "description": "Only the receipt reference; never copy native tokens.",
          "additionalProperties": false,
          "required": ["ref"],
          "properties": {"ref": {"$ref": "#/$defs/text"}}
        }
      }
    }
  }
}
