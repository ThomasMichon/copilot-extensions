#!/usr/bin/env sh
# Generated by libs/payload-invocation/generate.py. Do not edit.
set -eu

export PYTHONUTF8=1
_plugin="agent-pull-requests"
_command="agent-pull-requests"
_module="agent_pull_requests"
_self_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
_payload_root="$(CDPATH= cd -- "$_self_dir/.." && pwd -P)"
_runtime_root="$HOME/.agent-pull-requests"
_boot_trace_log_path="$_runtime_root/logs/boot-trace.jsonl"

_boot_trace_ms() {
    _bt_raw=""
    if _bt_raw="$(date +%s%3N 2>/dev/null)"; then
        case "$_bt_raw" in
            [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9])
                printf '%s\n' "$_bt_raw"
                return 0
                ;;
        esac
    fi
    if _bt_raw="$(date +%s%N 2>/dev/null)"; then
        case "$_bt_raw" in
            [0-9]*)
                if [ "${#_bt_raw}" -eq 19 ]; then
                    printf '%s\n' "${_bt_raw%??????}"
                    return 0
                fi
                ;;
        esac
    fi
    if _bt_raw="$(date +%s 2>/dev/null)"; then
        case "$_bt_raw" in
            [0-9]*) printf '%s000\n' "$_bt_raw"; return 0 ;;
        esac
    fi
    printf '0000000000000\n'
}

_boot_trace_iso() {
    if _bt_iso="$(date -u +%Y-%m-%dT%H:%M:%S+00:00 2>/dev/null)"; then
        printf '%s\n' "$_bt_iso"
        return 0
    fi
    printf '1970-01-01T00:00:00+00:00\n'
}

# Escapes backslash and double-quote so an inherited/environment-sourced
# value (HOSTNAME, an operator-set COPILOT_EXTENSIONS_BOOT_TRACE_PLUGIN
# override, etc.) can never produce a malformed JSONL line -- a raw
# interpolation would otherwise let a value containing `"` or `\` corrupt
# the record and silently drop it from every downstream reader (Copilot
# review, PR #3310). True POSIX sh has no builtin global substitution, so
# this uses sed (universally available); only called for a handful of
# fields per boot-trace call, not a hot per-byte path.
_boot_trace_escape_json() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

_boot_trace_log() {
    [ -n "${_boot_trace_log_path:-}" ] || return 0
    _bt_phase="$1"
    _bt_now_ms="$2"
    _bt_emitter="$3"
    _bt_resolution_source="${4-}"
    _bt_result="${5-}"
    _bt_version="${6-}"
    _bt_dispatch_path="${7-}"
    _bt_log_dir="${_boot_trace_log_path%/*}"
    if [ ! -d "$_bt_log_dir" ]; then
        mkdir -p "$_bt_log_dir" 2>/dev/null || return 0
    fi
    _bt_line="{\"ts\":\"$(_boot_trace_iso)\",\"event\":\"boot_trace\",\"plugin\":\"$(_boot_trace_escape_json "$_plugin")\",\"phase\":\"$(_boot_trace_escape_json "$_bt_phase")\",\"t_ms\":$_bt_now_ms,\"pid\":$$"
    if [ -n "${HOSTNAME:-}" ]; then
        _bt_line="$_bt_line,\"host\":\"$(_boot_trace_escape_json "$HOSTNAME")\""
    fi
    _bt_line="$_bt_line,\"source\":\"$(_boot_trace_escape_json "$_bt_emitter")\""
    if [ -n "$_bt_resolution_source" ]; then
        _bt_line="$_bt_line,\"resolution_source\":\"$(_boot_trace_escape_json "$_bt_resolution_source")\""
    fi
    if [ -n "$_bt_result" ]; then
        _bt_line="$_bt_line,\"result\":\"$(_boot_trace_escape_json "$_bt_result")\""
    fi
    if [ -n "$_bt_version" ]; then
        _bt_line="$_bt_line,\"version\":\"$(_boot_trace_escape_json "$_bt_version")\""
    fi
    if [ -n "$_bt_dispatch_path" ]; then
        _bt_line="$_bt_line,\"path\":\"$(_boot_trace_escape_json "$_bt_dispatch_path")\""
    fi
    _bt_line="$_bt_line}"
    { printf '%s\n' "$_bt_line" >> "$_boot_trace_log_path"; } 2>/dev/null || true
}

_boot_trace() {
    _bt_phase="$1"
    _bt_emitter="${2-}"
    _bt_resolution_source="${3-}"
    _bt_result="${4-}"
    _bt_version="${5-}"
    _bt_dispatch_path="${6-}"
    _bt_now_ms="$(_boot_trace_ms)"
    [ -n "$_bt_emitter" ] || _bt_emitter="shim"
    _boot_trace_log \
        "$_bt_phase" "$_bt_now_ms" "$_bt_emitter" \
        "$_bt_resolution_source" "$_bt_result" "$_bt_version" \
        "$_bt_dispatch_path"
    [ -n "${COPILOT_EXTENSIONS_BOOT_TRACE:-}" ] || return 0
    _bt_extra=""
    if [ -n "$_bt_resolution_source" ]; then
        _bt_extra="source=$_bt_resolution_source"
    fi
    if [ -n "$_bt_result" ]; then
        _bt_extra="${_bt_extra}${_bt_extra:+ }result=$_bt_result"
    fi
    if [ -n "$_bt_version" ]; then
        _bt_extra="${_bt_extra}${_bt_extra:+ }version=$_bt_version"
    fi
    if [ -n "$_bt_dispatch_path" ]; then
        _bt_extra="${_bt_extra}${_bt_extra:+ }path=$_bt_dispatch_path"
    fi
    if [ -n "$_bt_extra" ]; then
        printf '::boot-trace:: plugin=%s phase=%s t=%s %s\n' \
            "${COPILOT_EXTENSIONS_BOOT_TRACE_PLUGIN:-$_plugin}" \
            "$_bt_phase" "$_bt_now_ms" "$_bt_extra" >&2
    else
        printf '::boot-trace:: plugin=%s phase=%s t=%s\n' \
            "${COPILOT_EXTENSIONS_BOOT_TRACE_PLUGIN:-$_plugin}" \
            "$_bt_phase" "$_bt_now_ms" >&2
    fi
}

_boot_trace shim-start shim

if [ ! -f "$_payload_root/plugin.json" ]; then
    printf '[%s] payload root is not a plugin: %s\n' "$_command" "$_payload_root" >&2
    exit 126
fi

case "$PWD/" in
    "$_payload_root/"*)
        _outside="${COPILOT_PROJECT_DIR:-$HOME}"
        [ -d "$_outside" ] || _outside="${TMPDIR:-/tmp}"
        cd "$_outside"
        ;;
esac

_resolver="$_payload_root/scripts/resolve-runtime.sh"
_resolve_runtime() {
    AGENT_RT_PY=""
    export COPILOT_EXTENSIONS_BOOT_TRACE_PLUGIN="$_plugin"
    export COPILOT_EXTENSIONS_BOOT_TRACE_LOG_PATH="$_boot_trace_log_path"
    if [ -f "$_resolver" ]; then
        AGENT_RT_ROOT="$_runtime_root"
        export AGENT_RT_ROOT
        # shellcheck source=/dev/null
        . "$_resolver"
    fi
}

_resolve_runtime
_boot_trace resolver-loaded shim
if [ -n "${AGENT_RT_PY:-}" ]; then
    _boot_trace dispatch shim '' '' '' fast
    exec "$AGENT_RT_PY" -m "$_module" "$@"
fi
if [ -n "${AGENT_PULL_REQUESTS_NO_SELFPROVISION:-}" ]; then
    printf '[%s] runtime not provisioned (%s set).\n' \
        "$_command" "AGENT_PULL_REQUESTS_NO_SELFPROVISION" >&2
    exit 1
fi

mkdir -p "$_runtime_root"
_lock_link=""
_unlock_provision() {
    if [ -n "$_lock_link" ]; then
        _owner="$(readlink "$_lock_link" 2>/dev/null || true)"
        [ "$_owner" = "$$" ] && rm -f "$_lock_link"
        _lock_link=""
    else
        flock -u 9 2>/dev/null || true
        exec 9>&-
    fi
}
if command -v flock >/dev/null 2>&1 && [ "${COPILOT_EXT_NO_FLOCK:-}" != "1" ]; then
    exec 9>"$_runtime_root/.provision.lock"
    flock 9
else
    _lock_link="$_runtime_root/.provision.lock.pid"
    until ln -s "$$" "$_lock_link" 2>/dev/null; do
        _owner="$(readlink "$_lock_link" 2>/dev/null || true)"
        case "$_owner" in
            *[!0-9]*|"") _live=0 ;;
            *) if kill -0 "$_owner" 2>/dev/null; then _live=1; else _live=0; fi ;;
        esac
        if [ "$_live" = "0" ] && [ "$(readlink "$_lock_link" 2>/dev/null || true)" = "$_owner" ]; then
            rm -f "$_lock_link"
        else
            sleep 1
        fi
    done
fi
trap '_unlock_provision' EXIT INT TERM

_resolve_runtime
if [ -n "${AGENT_RT_PY:-}" ]; then
    _unlock_provision
    trap - EXIT INT TERM
    _boot_trace resolver-loaded
    exec "$AGENT_RT_PY" -m "$_module" "$@"
fi

_installer="$_payload_root/scripts/install.sh"
if [ ! -f "$_installer" ]; then
    printf '[%s] payload installer not found: %s\n' "$_command" "$_installer" >&2
    exit 127
fi

printf '[%s] runtime not provisioned -- provisioning from the owning payload.\n' \
    "$_command" >&2
printf '::agent-provisioning:: plugin=%s eta_seconds=120 reason=first-use\n' \
    "$_command" >&2
_boot_trace provision-start shim
bash "$_installer" provision >&2
_boot_trace provision-end shim
_resolve_runtime
if [ -n "${AGENT_RT_PY:-}" ]; then
    _unlock_provision
    trap - EXIT INT TERM
    _boot_trace resolver-loaded shim
    _boot_trace dispatch shim '' '' '' provisioned
    exec "$AGENT_RT_PY" -m "$_module" "$@"
fi
printf '[%s] provisioning completed without a resolvable runtime.\n' "$_command" >&2
exit 1
